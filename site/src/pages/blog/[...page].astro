---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatMonth, formatDay } from "../../lib/date";
import { Image } from "astro:assets";
import {
  getPublishedPosts,
  getSeriesMap,
  photoFor,
  formatPublished,
  excerptOf,
  seriesAnchor,
  BLOG_PAGE_SIZE,
} from "../../lib/blog";

// Pagination (2026-10-11): this one file builds /blog (page 1: header + featured +
// first BLOG_PAGE_SIZE rows) and /blog/page/2, /blog/page/3, … (rows only). Two-segment
// URLs can't collide with /blog/[slug]. Static, zero JS. The full list with search
// lives at /blog/archive (ADR 0002, amended).
export async function getStaticPaths() {
  const all = await getPublishedPosts();
  const feat = all.find((p) => p.data.featured) ?? all[0];
  const others = all.filter((p) => p !== feat);
  const pages = Math.max(1, Math.ceil(others.length / BLOG_PAGE_SIZE));
  return Array.from({ length: pages }, (_, i) => ({
    params: { page: i === 0 ? undefined : `page/${i + 1}` },
  }));
}

// Blog index — "TwelveTwelve: The Leader Blog". Design source:
// brand/prototype/page-blog.jsx (BlogPage). Newest post (or a `featured` one) gets
// the featured slot; the rest roll below as date-stamped rows.
//
// Series filter: GENERATED from the distinct `series` values (same zero-JS :target
// mechanism as /resources) and only rendered once there are 2+ series — today every
// post is "Meditation for Preparation", so a one-chip bar would be noise. While a
// filter is active the featured slot hides and the featured post's duplicate row
// (.is-featured-dup, hidden by default) shows in the list instead, so nothing matching
// the filter disappears.
const posts = await getPublishedPosts();
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const allRest = posts.filter((p) => p !== featuredPost);

const pageNum = Astro.params.page ? Number(Astro.params.page.split("/")[1]) : 1;
const pageCount = Math.max(1, Math.ceil(allRest.length / BLOG_PAGE_SIZE));
const isFirst = pageNum === 1;
const rest = allRest.slice((pageNum - 1) * BLOG_PAGE_SIZE, pageNum * BLOG_PAGE_SIZE);
// The featured slot + its filter duplicate exist on page 1 only.
const featured = isFirst ? featuredPost : undefined;
const pageHref = (n: number) => (n === 1 ? "/blog" : `/blog/page/${n}`);

const seriesMap = await getSeriesMap();
const seriesOf = (p: (typeof posts)[number]) => (p.data.series ? seriesMap[p.data.series.id] : undefined);
// Series actually in use, in first-seen (newest-post) order.
const seriesList = [...new Set(posts.map((p) => p.data.series?.id).filter(Boolean))].map(
  (id) => seriesMap[id as string],
);
// Page 1 only: a :target filter can only filter the rows on its own page.
const showFilter = isFirst && seriesList.length >= 2;
const seriesIds = seriesList.map((s) => seriesAnchor(s.id));
const countFor = (id: string) => posts.filter((p) => p.data.series?.id === id).length;
const featuredPhoto = featured ? photoFor(featured, seriesMap) : undefined;

const NAV_CLEARANCE = 96; // sticky Nav (~72px) + breathing room — matches /resources
const list = (fn: (id: string) => string) => seriesIds.map(fn).join(",\n");
const filterCss = showFilter
  ? `
.tgt { display: block; height: 0; scroll-margin-top: ${NAV_CLEARANCE}px; }
.bchip {
  font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--ink-2);
  padding: 8px 15px; border: 1px solid var(--line-strong);
  border-radius: var(--radius-pill);
  transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
}
.bchip:hover { border-color: var(--ink-3); }
.bchip .n { color: var(--ink-4); margin-left: 7px; }
.bchip-all { background: var(--ink); color: var(--bg); border-color: var(--ink); }
${list((id) => `#${id}:target ~ .bfilter .bchip-all`)} {
  background: transparent; color: var(--ink-2); border-color: var(--line-strong);
}
${list((id) => `#${id}:target ~ .bfilter .bchip-${id}`)} {
  background: var(--ink); color: var(--bg); border-color: var(--ink);
}
${list((id) => `#${id}:target ~ .bfeatured`)} { display: none; }
${list((id) => `#${id}:target ~ .blist .brow.is-featured-dup`)} { display: grid; }
${list((id) => `#${id}:target ~ .blist .brow:not(.${id})`)} { display: none; }
@media (max-width: 720px) { .bchip { font-size: 14px; } }
`
  : "";

const tagsFor = (p: (typeof posts)[number]) => (seriesOf(p) ? [seriesOf(p)!.label] : []);
---

<Layout
  title={isFirst ? "TwelveTwelve: The Leader Blog · North Wake Church" : `TwelveTwelve · Page ${pageNum} · North Wake Church`}
  description="TwelveTwelve, the leader blog of North Wake Church: weekly meditations from our pastors and leaders to help you prepare for Sunday."
>
  <Breadcrumb
    trail={isFirst
      ? [{ label: "Home", href: "/" }, { label: "Blog" }]
      : [{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: `Page ${pageNum}` }]}
  />

  <!-- Header — blog name is real (old site: "TwelveTwelve: The Leader Blog of North
       Wake Church"); the h1 + lede are UNVERIFIED placeholder copy (state doc). -->
  <!-- Header painting: John Singer Sargent, "From Jerusalem" (1905–06), The Met,
       public domain — Todd OK'd the scan + wants the credit shown (2026-10-11). -->
  {isFirst ? (
  <section class="bhero">
    <div class="wrap bhero-inner">
      <div class="eyebrow"><span class="dot"></span>TwelveTwelve · The Leader Blog</div>
      <h1 class="display-l bhero-title">Words from our pastors and leaders.</h1>
      <p class="lede bhero-lede">
        Weekly meditations to help you prepare for Sunday, written for the people of
        North Wake and anyone else who’d find them useful.
      </p>
      <p class="bhero-credit">
        From Jerusalem · John Singer Sargent, 1905–06<br />
        The Metropolitan Museum of Art · Public domain.
      </p>
    </div>
  </section>
  ) : (
  <section class="bhero-older">
    <div class="wrap">
      <div class="eyebrow"><span class="dot"></span>TwelveTwelve · The Leader Blog</div>
      <h1 class="display-m bhero-older-title">Older posts</h1>
    </div>
  </section>
  )}

  <div class="wrap broot">
    {showFilter && <a id="all" class="tgt"></a>}
    {showFilter && seriesIds.map((id) => <a id={id} class="tgt"></a>)}

    {
      showFilter && (
        <div class="bfilter">
          <a href="#all" class="bchip bchip-all">
            All <span class="n">{posts.length}</span>
          </a>
          {seriesList.map((s) => (
            <a href={`#${seriesAnchor(s.id)}`} class={`bchip bchip-${seriesAnchor(s.id)}`}>
              {s.label} <span class="n">{countFor(s.id)}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      featured && (
        <a class={`bfeatured${featuredPhoto ? " has-image" : ""}`} href={`/blog/${featured.id}`}>
          {featuredPhoto && (
            <Image
              class="bfeatured-img"
              src={featuredPhoto.src}
              alt={featuredPhoto.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 680px"
              loading="eager"
            />
          )}
          <div class="bfeatured-copy">
            <div class="mono bfeatured-kicker">
              Latest{seriesOf(featured) ? ` · ${seriesOf(featured)!.label}` : ""}
            </div>
            <h2 class="bfeatured-title">{featured.data.title}</h2>
            <p class="bfeatured-excerpt">{excerptOf(featured)}</p>
            <p class="bmeta">
              By {featured.data.author} · {formatPublished(featured.data.date)}
            </p>
            <span class="btn btn-ghost">
              Read post <span class="arr">→</span>
            </span>
          </div>
        </a>
      )
    }

    {
      (rest.length > 0 || showFilter) && (
        <div class="blist">
          <div class="eyebrow blist-head">
            <span class="dot"></span>{isFirst ? "More posts" : `Page ${pageNum} of ${pageCount}`}
          </div>
          {[featured, ...rest].filter(Boolean).map((p) => (
            <a
              class={`brow row-link${p === featured ? " is-featured-dup" : ""} ${p.data.series ? seriesAnchor(p.data.series.id) : ""}`}
              href={`/blog/${p.id}`}
            >
              <div class="brow-date" aria-hidden="true">
                <div class="mono brow-mon">{formatMonth(p.data.date)}</div>
                <div class="brow-day">{formatDay(p.data.date)}</div>
              </div>
              <div class="brow-main">
                {tagsFor(p).length > 0 && (
                  <div class="brow-tags">
                    {tagsFor(p).map((t) => (
                      <span class="mono brow-tag">{t}</span>
                    ))}
                  </div>
                )}
                <h3 class="brow-title">{p.data.title}</h3>
                <p class="brow-excerpt">{excerptOf(p)}</p>
                <p class="bmeta">
                  By {p.data.author} · {formatPublished(p.data.date)}
                </p>
              </div>
              <span class="row-arr brow-arr" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      )
    }

    {posts.length === 0 && <p class="bempty">New posts are on the way. Check back soon.</p>}

    {
      posts.length > 0 && (
        <nav class="bpager" aria-label="Blog pages">
          {pageNum > 1 ? (
            <a class="btn btn-ghost" href={pageHref(pageNum - 1)} rel="prev">
              <span class="arr">←</span> Newer posts
            </a>
          ) : <span />}
          {pageCount > 1 && <span class="mono bpager-count">Page {pageNum} of {pageCount}</span>}
          {pageNum < pageCount ? (
            <a class="btn btn-ghost" href={pageHref(pageNum + 1)} rel="next">
              Older posts <span class="arr">→</span>
            </a>
          ) : <span />}
          <a class="bpager-all" href="/blog/archive">Browse and search all posts →</a>
        </nav>
      )
    }
  </div>
</Layout>

{showFilter && <style is:global set:html={filterCss} />}

<style>
  /* Header — one column (label → headline → intro) over Sargent's "From Jerusalem".
     The painting sits on ::before, scaled up ~6% (inset −6%) so the scan's paper
     edge never shows; ::after is the cream wash (color-mix over --bg — token-derived,
     no literal): nearly solid behind the text on the left, fading right so the
     lavender sky and golden hills show. Contrast checked (see commit). */
  .bhero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .bhero::before,
  .bhero::after {
    content: "";
    position: absolute;
  }
  .bhero::before {
    inset: -6%;
    background: url("/blog-sargent-from-jerusalem.jpg") center 60% / cover no-repeat;
  }
  .bhero::after {
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 94%, transparent) 0%,
      color-mix(in srgb, var(--bg) 88%, transparent) 38%,
      color-mix(in srgb, var(--bg) 45%, transparent) 62%,
      color-mix(in srgb, var(--bg) 0%, transparent) 88%
    );
  }
  .bhero-inner {
    position: relative;
    z-index: 1;
  }
  .bhero-title {
    max-width: 18ch;
    margin-top: 28px;
  }
  .bhero-lede {
    color: var(--ink-2);
    max-width: 46ch;
    margin: 28px 0 0;
  }
  /* Artwork credit — bottom-left of the header (caption micro-type, exempt from the
     16px floor; never the sole carrier of meaning). */
  .bhero-credit {
    margin: 72px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .broot {
    padding-top: 56px;
    padding-bottom: 96px;
  }

  /* Series filter bar (only rendered with 2+ series; chip styles live in filterCss) */
  .bfilter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }

  /* Featured — image + copy side by side; text-only when the post has no image
     (no fake placeholder art on a live page). */
  .bfeatured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    color: inherit;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line);
  }
  .bfeatured.has-image {
    grid-template-columns: 1.1fr 1fr;
  }
  /* 16:9 — the same crop as the post page, and the shape the lettered series image
     ("Meditation for Preparation") is pre-cropped to. The old 5:4 cut the lettering
     off on the sides (2026-10-11). */
  .bfeatured-img {
    width: 100%;
    height: auto; /* else the <Image> height attribute (e.g. 864) wins and aspect-ratio never applies */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    display: block;
  }
  .bfeatured-copy {
    max-width: 720px;
  }
  .bfeatured-kicker {
    color: var(--accent);
    margin-bottom: 18px;
  }
  .bfeatured-title {
    /* Was clamp(36px, 4.8vw, 72px): too big beside the 16:9 image (3 lines at 1440).
       Now ~2 lines at desktop (Todd, 2026-10-11). */
    font-size: clamp(30px, 3.4vw, 52px);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
    transition: color 140ms ease;
  }
  .bfeatured:hover .bfeatured-title {
    color: var(--accent);
  }
  .bfeatured-excerpt {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 24px;
    max-width: 52ch;
  }
  .bfeatured .bmeta {
    margin-bottom: 28px;
  }

  .bmeta {
    font-size: 16px; /* content floor — author name is real content */
    line-height: 1.5;
    color: var(--ink-3);
    margin: 0;
  }

  /* List */
  .blist {
    padding-top: 72px;
  }
  .blist-head {
    margin-bottom: 16px;
  }
  .brow {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) auto;
    gap: 32px;
    align-items: baseline;
    padding-top: 32px;
    padding-bottom: 32px;
    color: inherit;
  }
  .brow.is-featured-dup {
    display: none; /* shown only while a series filter is active (filterCss) */
  }
  .brow-mon {
    color: var(--accent);
    margin-bottom: 4px;
  }
  .brow-day {
    font-family: var(--display);
    font-weight: 500;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .brow-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .brow-tag {
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    color: var(--ink-3);
  }
  .brow-title {
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
    max-width: 32ch;
  }
  .brow-excerpt {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0 0 12px;
    max-width: 60ch;
  }
  .brow-arr {
    color: var(--accent);
    align-self: center;
  }

  /* Later pages: a quiet header instead of the painting. */
  .bhero-older {
    padding: 72px 0 0;
  }
  .bhero-older-title {
    margin-top: 24px;
  }

  /* Pager — Newer · Page X of N · Older, then the archive/search link. */
  .bpager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .bpager a[rel="prev"] {
    justify-self: start; /* a grid item would otherwise stretch the button */
  }
  .bpager a[rel="next"] {
    justify-self: end;
  }
  .bpager-count {
    color: var(--ink-3);
  }
  .bpager-all {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 8px;
    font-size: 16px;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }
  .bpager-all:hover {
    color: var(--ink);
  }

  .bempty {
    font-size: 18px;
    color: var(--ink-3);
  }

  /* Phones: the text spans the full width → a top-to-bottom wash instead, solid
     behind the text and lighter toward the bottom so the hills show below it. */
  @media (max-width: 560px) {
    .bhero::after {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg) 86%, transparent) 70%,
        color-mix(in srgb, var(--bg) 55%, transparent) 100%
      );
    }
  }
  @media (max-width: 900px) {
    .bfeatured.has-image {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  @media (max-width: 720px) {
    .bhero {
      padding-top: 56px;
    }
    .broot {
      padding-top: 40px;
    }
    .bfeatured {
      padding-bottom: 48px;
    }
    .blist {
      padding-top: 48px;
    }
    .brow {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 18px;
    }
    .brow-day {
      font-size: 28px;
    }
    .brow-arr {
      display: none;
    }
  }
</style>
