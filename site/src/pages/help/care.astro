---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { BUSINESS } from "../../data/business";

// Care Ministry page (/help/care). Built from brand/prototype/CARE-MINISTRY-SPEC.md
// + care-ministry.html. Copy is the church's text; the design's sentence splits
// across the steps + its labels/headline were approved by Todd 2026-09-23.
// "dispersed" → "disbursed" (typo fix) and the duplicate "Funds are released
// quarterly." section intro removed, both per Todd 2026-09-23.
// Sections: 1) Breadcrumb, 2) Hero (Help-group split — mirrors help/feed.astro),
// 3) Facts strip, 4) Our heart, 5) How to apply, 6) Where to apply (dark band).
//
// NOT on the page (not provided — don't invent): office hours, a contact for
// questions, Building Five wayfinding. Logged in the state doc.
//
// The package's dark band used [data-theme="dim"]; this site's dark bands use the
// inverse tokens, and a dark-band CTA is .btn-accent (who-is-jesus, mature-adults)
// — .btn-primary is ink-on-ink there. No global change.

const facts = [
  { l: "Helps with", v: "Portions of housing or utility expenses" },
  { l: "Funds released", v: "Quarterly" },
  { l: "Application", v: "In person · 10 minutes" },
  { l: "Interview", v: "Typically 45 minutes" },
];

const steps = [
  {
    t: "Apply in person",
    b: "Please complete an application in person at our church office reception desk in Building Five. The application takes 10 minutes to complete.",
  },
  {
    t: "Meet and pray",
    b: "The care team schedules a meeting to pray for applicants. The interview typically takes 45 minutes with our care team.",
  },
  {
    t: "Funds disbursed",
    b: "Funds are released quarterly, and disbursed on a first-come, first-served basis until they are depleted for each quarter.",
  },
];
---

<Layout
  title="Care Ministry · North Wake Church"
  description="The North Wake Care Team provides emergency financial assistance to cover portions of housing or utility expenses for our neighbors in Wake Forest."
>
  <!-- 1. Breadcrumb ("Help" has no page → non-clickable chip) -->
  <Breadcrumb trail={[{ label: "Home", href: "/" }, { label: "Help" }, { label: "Care Ministry" }]} />

  <!-- 2. Hero — Help-group split (same shape/values as the Feed hero) -->
  <section class="care-hero" aria-labelledby="care-title">
    <div class="wrap">
      <div class="care-hero-grid">
        <div>
          <div class="eyebrow care-hero-eyebrow"><span class="dot"></span>North Wake Care Team · Emergency financial assistance</div>
          <h1 id="care-title" class="display-l care-h1">
            Demonstrating love for our neighbors in <span class="care-accent">Wake Forest.</span>
          </h1>
          <p class="lede care-lede">
            The North Wake Care Team seeks to demonstrate love for our neighbors in Wake Forest by providing emergency financial assistance to cover portions of housing or utility expenses.
          </p>
          <div class="care-hero-actions">
            <a class="btn btn-primary" href="#how-to-apply">How to apply <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </div>
        <!-- PHOTO PLACEHOLDER. PRIVACY: this page describes financial hardship — the
             real photo must NEVER show anyone identifiable as a recipient. Consenting
             volunteers, hands/table/office only (CARE-MINISTRY-SPEC.md §9). -->
        <div class="ph care-hero-ph"><span class="ph-label">Photo · Care team · praying with a neighbor</span></div>
      </div>
    </div>
  </section>

  <!-- 3. Facts strip — hairline grid -->
  <section class="care-facts-sec" aria-label="Assistance at a glance">
    <div class="wrap">
      <dl class="care-facts">
        {
          facts.map((f) => (
            <div class="care-fact">
              <dt class="mono">{f.l}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 4. Our heart -->
  <section aria-labelledby="care-heart-title">
    <div class="wrap">
      <div class="care-heart">
        <div>
          <div class="eyebrow care-eyebrow"><span class="dot"></span>Our heart</div>
          <h2 id="care-heart-title" class="display-m care-heart-h2">Tangible help. <span class="care-accent">Lasting hope.</span></h2>
        </div>
        <div class="care-heart-stack">
          <div class="care-heart-item">
            <div class="mono care-heart-label">For physical needs</div>
            <p class="body care-heart-body">
              These funds, collected from North Wake Church, are intended to tangibly show recipients God's great love for every individual through assistance from the local church.
            </p>
          </div>
          <div class="care-heart-item">
            <div class="mono care-heart-label">Beyond physical needs</div>
            <p class="care-heart-serif">
              Beyond caring for physical needs, our great desire is that everyone would hear of their profound need for <em>Jesus Christ</em> while receiving prayer from team members.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. How to apply (target of the hero jump link) -->
  <section id="how-to-apply" class="care-apply" aria-labelledby="care-apply-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow care-eyebrow"><span class="dot"></span>How to apply</div>
          <h2 id="care-apply-title" class="display-m care-apply-h2">Three steps, in person.</h2>
        </div>
      </div>
      <ol class="care-steps">
        {
          steps.map((s, i) => (
            <li class="care-step">
              <div class="care-step-num" aria-hidden="true">0{i + 1}</div>
              <h3 class="title care-step-h">{s.t}</h3>
              <p class="body care-step-body">{s.b}</p>
            </li>
          ))
        }
      </ol>
      <!-- The one eligibility rule a reader must not miss → full-strength ink. -->
      <div class="care-note" role="note">
        <div class="mono care-note-label">Please note</div>
        <p class="body care-note-body">
          Applicants who received funding from North Wake in the last 12 months must wait to reapply until that 12-month period has passed.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Where to apply — DARK band, inverse tokens -->
  <section class="care-where-sec" aria-labelledby="care-where-title">
    <div class="wrap">
      <div class="care-where">
        <div>
          <div class="eyebrow care-where-eyebrow"><span class="dot"></span>Where to apply</div>
          <h2 id="care-where-title" class="display-l care-where-h2">
            Church office reception desk, <span class="care-where-accent">Building Five.</span>
          </h2>
        </div>
        <div class="care-where-addr">
          <div class="mono care-where-label">Address</div>
          <address>{BUSINESS.streetAddress}<br />{BUSINESS.city}, {BUSINESS.state}</address>
          <a class="btn btn-accent" href={BUSINESS.mapsUrl} target="_blank" rel="noopener">
            Get directions <span class="arr" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Page-scoped (no global .sr-only exists; kept local to avoid a global.css change). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .care-eyebrow {
    margin-bottom: 18px;
  }
  .care-accent {
    color: var(--accent);
  }

  /* 2 · Hero — values mirror help/feed.astro (.feed-hero*) so the Help pages match. */
  .care-hero {
    padding: 56px 0 0;
  }
  .care-hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: end; /* photo's bottom edge lines up with the button row */
  }
  .care-hero-eyebrow {
    margin-bottom: 28px;
  }
  .care-h1 {
    max-width: 15ch;
  }
  .care-lede {
    margin-top: 28px;
  }
  .care-hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .care-hero-ph {
    aspect-ratio: 4 / 5;
  }

  /* 3 · Facts strip */
  .care-facts-sec {
    padding: 80px 0 0;
  }
  .care-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .care-fact {
    background: var(--bg);
    padding: 28px 24px;
  }
  .care-fact dt {
    margin-bottom: 10px;
  }
  .care-fact dd {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }

  /* 4 · Our heart (2px ink rule — same device as Church Planting's realities) */
  .care-heart {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 72px;
    align-items: start;
  }
  .care-heart-h2 {
    max-width: 12ch;
  }
  .care-heart-stack {
    display: grid;
    gap: 1px;
    background: var(--line);
    border-top: 2px solid var(--ink);
  }
  .care-heart-item {
    background: var(--bg);
    padding: 28px 0 32px;
  }
  .care-heart-item:last-child {
    padding-bottom: 8px;
  }
  .care-heart-label {
    color: var(--accent);
    margin-bottom: 12px;
  }
  .care-heart-body {
    margin: 0;
    font-size: 19px;
    color: var(--ink);
    max-width: 54ch;
  }
  .care-heart-serif {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 40ch;
  }
  .care-heart-serif em {
    color: var(--accent);
  }

  /* 5 · How to apply. scroll-margin clears the sticky nav (18px×2 padding + ~44px
     row ≈ 80px) when the hero's #how-to-apply link jumps here. */
  .care-apply {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .care-apply-h2 {
    max-width: 14ch;
  }
  .care-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .care-step {
    background: var(--bg);
    padding: 36px 32px 40px;
  }
  .care-step-num {
    font-size: clamp(44px, 4.4vw, 64px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .care-step-h {
    margin-bottom: 12px;
  }
  .care-step-body {
    margin: 0;
    font-size: 17px;
  }
  .care-note {
    margin-top: 32px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 24px 28px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }
  .care-note-label {
    color: var(--ink);
  }
  .care-note-body {
    margin: 0;
    font-size: 17px;
    color: var(--ink);
  }

  /* 6 · Where to apply — DARK band, inverse semantic tokens only (accent TEXT on
     dark must be --accent-on-inverse; clay-600 fails at 2.69:1). */
  .care-where-sec {
    background: var(--bg-inverse);
    color: var(--ink-on-inverse);
  }
  .care-where {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 64px;
    align-items: end;
  }
  .care-where-eyebrow {
    margin-bottom: 24px;
    color: var(--ink-on-inverse-2);
  }
  .care-where-eyebrow .dot {
    background: var(--accent-on-inverse);
  }
  .care-where-h2 {
    max-width: 14ch;
  }
  .care-where-accent {
    color: var(--accent-on-inverse);
  }
  .care-where-addr {
    border-top: 1px solid var(--line-on-inverse-strong);
    padding-top: 24px;
  }
  .care-where-label {
    margin-bottom: 8px;
    color: var(--ink-on-inverse-2);
  }
  .care-where-addr address {
    font-style: normal;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.35;
    margin-bottom: 28px;
  }

  /* Responsive — hero stacks at 720 like Feed; the rest per the spec's 1080/880. */
  @media (max-width: 1080px) {
    .care-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 880px) {
    .care-heart,
    .care-where {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .care-steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .care-hero {
      padding-top: 40px;
    }
    .care-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .care-facts-sec {
      padding-top: 64px;
    }
    .care-step {
      padding: 28px 22px 32px;
    }
    /* Don't undercut the site's mobile type scale (global.css §j: .body → 18px). */
    .care-step-body,
    .care-note-body {
      font-size: 18px;
    }
  }
  @media (max-width: 560px) {
    .care-facts {
      grid-template-columns: 1fr;
    }
    .care-note {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px 22px;
    }
    .care-where-addr .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
