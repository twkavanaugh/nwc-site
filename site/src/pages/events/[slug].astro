---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render } from "astro:content";
import { BUSINESS } from "../../data/business";
import { formatMonth, formatDay, formatLong } from "../../lib/date";

// Unified event detail — "continuous column" design (brand/prototype/
// EVENT-DETAIL-CONTINUOUS-SPEC.md). One template for every event; absent fields
// render as absent rows (never dead buttons). The left column flows continuously —
// eyebrow → title → subtitle → contact → (image) → prose, no section band. getStaticPaths
// builds a page for EVERY entry, past or upcoming (only /events filters by date).
export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Derived eyebrow: prettified ministryId + date when a ministry is set, else the date alone.
const prettyMinistry = d.ministryId
  ? d.ministryId.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())
  : null;
const eyebrow = prettyMinistry ? `${prettyMinistry} · ${formatLong(d.startDate)}` : formatLong(d.startDate);

// Location defaults to the church (BUSINESS) when the entry doesn't override it.
const placeName = d.location ?? BUSINESS.name;
const placeAddress = d.location
  ? null
  : `${BUSINESS.streetAddress} · ${BUSINESS.city}, ${BUSINESS.state} ${BUSINESS.postalCode}`;

const hasImage = Boolean(d.image);
const imageAlt = d.imageAlt ?? d.title; // real alt preferred; title is the fallback
---

<Layout title={`${d.title} · Events · North Wake Church`} description={d.subtitle ?? d.title}>
  <!-- Breadcrumb (first in body) -->
  <Breadcrumb
    trail={[{ label: "Home", href: "/" }, { label: "Events", href: "/events" }, { label: d.title }]}
  />

  <section class="ev-detail">
    <div class="wrap ev-wrap">
      <div class="ev-grid">
        <!-- Header block (col 1, row 1) -->
        <div class="ev-head">
          <div class="eyebrow ev-eyebrow"><span class="dot"></span>{eyebrow}</div>
          <h1 class="ev-title">{d.title}</h1>
          {d.subtitle && <p class="ev-sub">{d.subtitle}</p>}
          {
            d.contactEmail && (
              /* Inert: unverified church email — plain text, NO mailto (email discipline). */
              <p class="ev-contact">
                Questions? <span class="ev-contact-email">{d.contactEmail}</span> — email pending verification.
              </p>
            )
          }
        </div>

        <!-- Facts box (col 2, spans both rows). Shaded --bg-2 rail only when an image is present. -->
        <div class:list={["ev-rail", { "ev-rail-shaded": hasImage }]}>
          <aside class="ev-facts">
            <div class="ev-facts-cal">
              <span class="ev-facts-month">{formatMonth(d.startDate)}</span>
              <span class="ev-facts-day">{formatDay(d.startDate)}</span>
            </div>
            <dl class="ev-facts-rows">
              <div class="ev-facts-row">
                <dt class="ev-facts-k">Date</dt>
                <dd class="ev-facts-v">{formatLong(d.startDate)}</dd>
              </div>
              {
                d.time && (
                  <div class="ev-facts-row">
                    <dt class="ev-facts-k">Time</dt>
                    <dd class="ev-facts-v">
                      {d.time}
                      {d.timeNote && <small class="ev-facts-note">{d.timeNote}</small>}
                    </dd>
                  </div>
                )
              }
              <div class="ev-facts-row">
                <dt class="ev-facts-k">Place</dt>
                <dd class="ev-facts-v">
                  {placeName}
                  {placeAddress && <small class="ev-facts-note">{placeAddress}</small>}
                </dd>
              </div>
              {
                d.cost && (
                  <div class="ev-facts-row">
                    <dt class="ev-facts-k">Cost</dt>
                    <dd class="ev-facts-v">{d.cost}</dd>
                  </div>
                )
              }
            </dl>
            {
              d.registrationUrl && (
                <div class="ev-facts-cta">
                  <a class="btn btn-primary ev-facts-btn" href={d.registrationUrl}>
                    <span>Register</span>
                    <span aria-hidden="true">→</span>
                  </a>
                  {d.deadline && <p class="ev-deadline">{d.deadline}</p>}
                </div>
              )
            }
          </aside>
        </div>

        <!-- Main column (col 1, row 2): optional 21:8 image, then continuous prose -->
        <div class="ev-main">
          {hasImage && <img class="ev-poster" src={d.image} alt={imageAlt} />}
          <div class="ev-prose">
            <Content />
          </div>
        </div>
      </div>

      <div class="ev-browse">
        <a class="btn btn-ghost" href="/events">← Browse all events</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Continuous-column layout: header (col1/row1) + facts (col2, spans) + main (col1/row2).
     One DOM order (head → facts → main) gives the continuous left column on desktop AND
     the correct mobile stack (header → facts → prose) when it collapses to one column. */
  .ev-wrap {
    max-width: 1240px;
  }
  .ev-grid {
    display: grid;
    grid-template-columns: 1.5fr 420px;
    gap: 0 72px;
    align-items: start;
  }
  .ev-head {
    grid-column: 1;
    grid-row: 1;
  }
  .ev-rail {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .ev-rail-shaded {
    background: var(--bg-2);
    padding: 20px;
    margin: -20px; /* bleed the shade 20px around the facts box while keeping it on the grid line */
  }
  .ev-main {
    grid-column: 1;
    grid-row: 2;
    margin-top: 40px;
  }

  /* Header */
  .ev-eyebrow {
    margin-bottom: 0;
  }
  .ev-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(46px, 6.4vw, 88px); /* Q7 — spec 88 desktop / 46 mobile */
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin: 24px 0 0;
  }
  .ev-sub {
    font-size: clamp(18px, 1.8vw, 22px); /* 22 desktop / 18 mobile */
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 42ch;
    margin: 18px 0 0;
  }
  .ev-contact {
    font-size: 16px; /* Q1 — policy floor (spec had 14; readable sentence = content) */
    line-height: 1.6;
    color: var(--ink-3);
    margin: 22px 0 0;
  }
  .ev-contact-email {
    color: var(--ink-2);
  }

  /* Featured image (21:8) */
  .ev-poster {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    border: 1px solid var(--line);
    margin-bottom: 40px;
  }

  /* Facts box */
  .ev-facts {
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .ev-facts-cal {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 28px 28px 22px;
    border-bottom: 1px solid var(--line);
  }
  .ev-facts-month {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ev-facts-day {
    font-family: var(--display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .ev-facts-rows {
    margin: 0;
  }
  .ev-facts-row {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 18px;
    align-items: baseline;
    padding: 18px 28px;
    border-bottom: 1px solid var(--line);
  }
  .ev-facts-row:last-of-type {
    border-bottom: none;
  }
  .ev-facts-k {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px; /* mono micro-label — exempt from the content floor (cf. .ph-label) */
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ev-facts-v {
    margin: 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ev-facts-note {
    display: block;
    margin-top: 3px;
    font-size: 14px; /* Q1 — .small caption tier (spec had 13.5; caption exempt, but held at 14) */
    font-weight: 400;
    color: var(--ink-3);
  }
  .ev-facts-cta {
    padding: 20px 28px 26px;
    border-top: 1px solid var(--line);
  }
  .ev-facts-btn {
    width: 100%;
    justify-content: space-between;
  }
  .ev-deadline {
    margin: 14px 0 0;
    font-size: 16px; /* content */
    color: var(--ink-3);
    text-align: center;
  }

  /* Body prose — styles the rendered Markdown (<Content/> output is unscoped). */
  .ev-prose :global(p) {
    font-size: 18px; /* content; 16 on mobile */
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0 0 20px;
    max-width: 58ch;
  }
  .ev-prose :global(h2) {
    font-family: var(--display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    margin: 40px 0 16px;
  }
  .ev-prose :global(ul) {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ev-prose :global(li) {
    position: relative;
    padding-left: 18px;
    font-size: 16px; /* content floor */
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ev-prose :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Browse all */
  .ev-browse {
    text-align: center;
    padding-top: 96px;
  }

  /* Mobile (variant C): single column, DOM order header → facts → prose. */
  @media (max-width: 720px) {
    .ev-grid {
      grid-template-columns: 1fr;
    }
    .ev-head,
    .ev-rail,
    .ev-main {
      grid-column: 1;
      grid-row: auto;
    }
    .ev-rail {
      margin-top: 32px;
    }
    /* Neutralize the desktop bleed margins on mobile (would overflow the narrow viewport). */
    .ev-rail-shaded {
      margin: 32px 0 0;
      padding: 16px;
    }
    .ev-main {
      margin-top: 36px;
    }
    .ev-facts-cal {
      padding: 22px 22px 18px;
    }
    .ev-facts-day {
      font-size: 46px;
    }
    .ev-facts-row {
      grid-template-columns: 62px 1fr;
      padding: 16px 22px;
    }
    .ev-facts-v {
      font-size: 16px;
    }
    .ev-prose :global(p) {
      font-size: 16px;
    }
    .ev-browse {
      padding-top: 56px;
    }
  }
</style>
