---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WarmBandHero from "../../components/WarmBandHero.astro";

// Church Planting page (/mission/church-planting). Built from
// brand/prototype/CHURCH-PLANTING-SPEC.md + church-planting.html. Copy is the
// church's approved text; three typos fixed per Todd 2026-09-23 ("places",
// "ongoing", "early ’90s"). Section labels (Our heritage, Kingdom work, …) were
// added by design and approved by Todd 2026-09-23.
// Sections: 1) Breadcrumb, 2) Hero, 3) Two realities + bridge (dark band),
// 4) The churches, 5) Kingdom work, 6) How we engage.
//
// The package's dark band used [data-theme="dim"]; this site's dark bands use the
// inverse tokens instead (--bg-inverse / --ink-on-inverse / --accent-on-inverse),
// so no global change is needed. All other blocks are page-scoped
// (prove-twice-then-extract).

// When a partner becomes self-sustaining, change its `category` — one line.
// No `url`s yet: names render as plain text until the church provides links.
type Church = { name: string; place: string; category: "self-sustaining" | "partner"; url?: string };
const churches: Church[] = [
  { name: "Covenant Life Church", place: "Tampa, Florida", category: "self-sustaining" },
  { name: "Restoration Church", place: "Washington D.C.", category: "self-sustaining" },
  { name: "Exchange Church", place: "Rolesville, North Carolina", category: "self-sustaining" },
  { name: "Mosaic Church", place: "Provo, Utah", category: "partner" },
  { name: "Kings Village Church", place: "Clemmons, North Carolina", category: "partner" },
  { name: "Iglesia Biblica Sublime Gracia", place: "Washington D.C.", category: "partner" },
];

const lists = [
  {
    kicker: "Self sustaining",
    title: "Self Sustaining Churches",
    def: "Those who have grown to no longer require our support and care.",
    items: churches.filter((c) => c.category === "self-sustaining"),
  },
  {
    kicker: "Planting partners",
    title: "Church Planting Partners",
    def: "Those whom we continue to partner with to encourage their daily flourishing.",
    items: churches.filter((c) => c.category === "partner"),
  },
];

const engage = [
  { kind: "what", label: "What we do", title: "Celebrating", body: "our self sustaining churches" },
  { kind: "what", label: "What we do", title: "Supporting", body: "our church planting partners" },
  { kind: "what", label: "What we do", title: "Developing", body: "new church planting endeavors" },
  { kind: "how", label: "How we do it", title: "Diligent prayer" },
  { kind: "how", label: "How we do it", title: "Generous investment" },
  { kind: "how", label: "How we do it", title: "Ongoing development", body: "of the next generation of church planters" },
];
---

<Layout
  title="Church Planting · North Wake Church"
  description="Church planting is at the very center of who North Wake is and will always be — rooted in our heritage and our conviction to expand Christ’s kingdom."
>
  <!-- 1. Breadcrumb ("Mission" has no index page → non-clickable chip) -->
  <Breadcrumb trail={[{ label: "Home", href: "/" }, { label: "Mission" }, { label: "Church Planting" }]} />

  <!-- 2. Hero — F · Warm Band (sentence-length headline → display-m, no CTAs) -->
  <WarmBandHero
    titleId="cp-title"
    headlineSize="m"
    eyebrow="Mission · Church planting"
    headlineLead="Church planting is at the very center of who North Wake is"
    headlineAccent="and will always be."
    lede="This is largely due to two realities."
    photoPlaceholder="Photo · Church plant · launch Sunday"
  />

  <!-- 3. Two realities + bridge -->
  <section aria-label="Two realities">
    <div class="wrap">
      <div class="cp-two">
        <article class="cp-reality">
          <div class="cp-reality-num" aria-hidden="true">01</div>
          <h2 class="display-s cp-reality-h">Our heritage</h2>
          <p class="body cp-reality-body">
            First, we as a church family were planted in Wake Forest in the early ’90s by another older and more established church. Our very history and heritage depends on the courage of Providence Church (Raleigh NC) to take the risk of starting a new fellowship in an area that needed one.
          </p>
        </article>
        <article class="cp-reality">
          <div class="cp-reality-num" aria-hidden="true">02</div>
          <h2 class="display-s cp-reality-h">Our conviction</h2>
          <p class="body cp-reality-body">
            Second, we believe this is the burden and responsibility of vibrant churches; to expand Christ’s kingdom into places where God is working.
          </p>
        </article>
      </div>
      <div class="cp-bridge">
        <div class="cp-bridge-label">Heritage + conviction</div>
        <p>
          <span class="cp-bridge-accent">So based on our heritage and conviction,</span> we likewise have planted several churches over the years. Some continue to this very day, others have run their course and passed the baton to others to continue the work of making disciples.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. The churches -->
  <section class="cp-churches" aria-labelledby="cp-churches-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow cp-eyebrow"><span class="dot"></span>The churches</div>
          <h2 id="cp-churches-title" class="display-m cp-churches-h2">Churches we’ve planted and partner with.</h2>
        </div>
        <p class="body right">We could identify those remaining churches into a couple of categories.</p>
      </div>
      <div class="cp-lists">
        {
          lists.map((l) => (
            <div class="cp-list">
              <div class="mono cp-list-kicker">{l.kicker}</div>
              <h3 class="display-s cp-list-h">{l.title}</h3>
              <p class="body cp-list-def">{l.def}</p>
              <ul class="cp-list-items">
                {l.items.map((c) => (
                  <li class="cp-church">
                    <span class="cp-church-name">{c.name}</span>
                    <span class="cp-church-place">{c.place}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="body cp-churches-note">
        Some of these works we have planted directly out of our fellowship, others have been works that partner with existing churches to assist in the church planting process.
      </p>
    </div>
  </section>

  <!-- 5. Kingdom work — the page's one serif moment -->
  <section class="cp-kingdom" aria-label="Kingdom work">
    <div class="wrap-narrow">
      <div class="eyebrow cp-kingdom-eyebrow"><span class="dot"></span>Kingdom work</div>
      <p class="cp-kingdom-statement">
        We believe that church planting is kingdom work, that collaborates with healthy planters, churches, and organizations to advance <em>Christ’s mission to reach all people everywhere.</em>
      </p>
    </div>
  </section>

  <!-- 6. How we engage -->
  <section class="cp-engage-sec" aria-labelledby="cp-engage-title">
    <div class="wrap">
      <div class="cp-engage">
        <div>
          <h2 class="eyebrow cp-eyebrow" id="cp-engage-title"><span class="dot"></span>How we engage</h2>
          <p class="lede cp-engage-lede">
            We continue to engage in church planting through celebrating our self sustaining churches, supporting our church planting partners, and developing new church planting endeavors. We do this through diligent prayer, generous investment, and ongoing development of the next generation of church planters.
          </p>
        </div>
        <ul class="cp-engage-grid">
          {
            engage.map((c) => (
              <li class={`cp-cell${c.kind === "how" ? " is-how" : ""}`}>
                <div class="mono cp-cell-label">{c.label}</div>
                <div class="cp-cell-title">{c.title}</div>
                {c.body && <div class="body cp-cell-body">{c.body}</div>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cp-eyebrow {
    margin-bottom: 18px;
  }

  /* 3 · Two realities */
  .cp-two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
  }
  /* The one 2px rule on the page — deliberate: these are its strongest marks. */
  .cp-reality {
    border-top: 2px solid var(--ink);
    padding-top: 28px;
  }
  .cp-reality-num {
    font-size: clamp(56px, 6vw, 88px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .cp-reality-h {
    margin-bottom: 20px;
  }
  .cp-reality-body {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    max-width: 50ch;
  }

  /* 3b · Bridge — dark band on the site's inverse tokens (accent TEXT on dark must
     be --accent-on-inverse; clay-600 fails at 2.69:1). */
  .cp-bridge {
    margin-top: 88px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 64px;
    align-items: start;
    background: var(--bg-inverse);
    color: var(--ink-on-inverse);
    padding: 56px 56px 60px;
  }
  .cp-bridge-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-on-inverse);
    padding-top: 10px;
  }
  .cp-bridge p {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }
  .cp-bridge-accent {
    color: var(--accent-on-inverse);
  }

  /* 4 · The churches */
  .cp-churches {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cp-churches-h2 {
    max-width: 16ch;
  }
  .cp-lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cp-list {
    background: var(--bg);
    padding: 40px 36px 36px;
    display: flex;
    flex-direction: column;
  }
  .cp-list-kicker {
    color: var(--accent);
    margin-bottom: 14px;
  }
  .cp-list-h {
    font-weight: 600;
    margin-bottom: 12px;
  }
  .cp-list-def {
    margin: 0 0 28px;
    font-size: 17px;
    max-width: 40ch;
  }
  /* margin-top:auto pins both lists to the bottom so they align even when the
     definitions wrap to different heights. */
  .cp-list-items {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .cp-church {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .cp-church-name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .cp-church-place {
    font-size: 16px;
    color: var(--ink-3);
    text-align: right;
  }
  .cp-churches-note {
    margin: 40px 0 0;
    font-size: 18px;
    line-height: 1.65;
    max-width: 64ch;
  }

  /* 5 · Kingdom work */
  .cp-kingdom {
    text-align: center;
  }
  .cp-kingdom-eyebrow {
    margin-bottom: 28px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cp-kingdom-statement {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cp-kingdom-statement em {
    font-style: italic;
    color: var(--accent);
  }

  /* 6 · How we engage (hairline above acts as the divider → no top padding) */
  .cp-engage-sec {
    padding-top: 0;
  }
  .cp-engage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 64px;
    align-items: start;
    border-top: 1px solid var(--line-strong);
    padding-top: 56px;
  }
  .cp-engage-lede {
    max-width: 40ch;
  }
  .cp-engage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cp-cell {
    background: var(--bg);
    padding: 28px 24px;
    min-height: 140px;
  }
  .cp-cell.is-how {
    background: var(--bg-2);
  }
  .cp-cell-label {
    color: var(--accent);
    margin-bottom: 12px;
  }
  .cp-cell.is-how .cp-cell-label {
    color: var(--ink-3);
  }
  .cp-cell-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.25;
  }
  .cp-cell-body {
    margin-top: 6px;
  }

  /* Responsive — breakpoints per CHURCH-PLANTING-SPEC.md §7 */
  @media (max-width: 1240px) {
    .cp-engage {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 880px) {
    .cp-two,
    .cp-lists {
      grid-template-columns: 1fr;
    }
    .cp-two {
      gap: 56px;
    }
    .cp-bridge {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 40px 28px 44px;
      margin-top: 72px;
    }
    .cp-bridge-label {
      padding-top: 0;
    }
    .cp-engage-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .cp-list {
      padding: 32px 22px 28px;
    }
  }
  @media (max-width: 560px) {
    .cp-engage-grid {
      grid-template-columns: 1fr;
    }
    .cp-cell {
      min-height: 0;
    }
    /* Stack name over place so long names aren't crushed beside the city. */
    .cp-church {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .cp-church-place {
      text-align: left;
    }
    .cp-reality-body,
    .cp-churches-note {
      font-size: 17px;
    }
  }
</style>
