---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { resourceTarget, getFeaturedResource } from "../../lib/resources";
// Static background for the featured card (not per-item). PLACEHOLDER until the
// photographer's images arrive — Unsplash, Marlon Reyes (licence confirmed by Todd).
import featuredPhoto from "../../assets/resources/featured-landscape.jpg";

// Resources index — list view. Design source: brand/prototype/RESOURCES-LIST.html
// (Gate 2 plan + rulings). The catalog MERGES two collections — every `resources`
// entry (rendered per its type) plus every non-draft `posts` entry (rendered as a
// read-on-site card linking to /resources/<slug>; that route is built in Gate 3b —
// it 404s until then, expected). Filtering is 100% CSS via :target; the per-category
// filter rules are GENERATED from the categories collection (below) so adding a
// category needs zero CSS edits.

// --- Categories: drive chips / tgt anchors / tags / counts ---
const categoryEntries = await getCollection("categories");
// Curated order: sort by the category's `order` ascending where present, then
// alphabetical by id for any without one. This one sorted array drives the tgt
// anchors, chips, tags, and the generated :target CSS — all stay in lockstep.
const categories = categoryEntries
  .map((c) => ({ id: c.id, label: c.data.label, order: c.data.order }))
  .sort((a, b) => {
    if (a.order != null && b.order != null) return a.order - b.order;
    if (a.order != null) return -1;
    if (b.order != null) return 1;
    return a.id.localeCompare(b.id);
  });
const catIds = categories.map((c) => c.id);
const labelOf = Object.fromEntries(categories.map((c) => [c.id, c.label]));

// --- type enum → glyph / kicker / action label (schema enum wins over package) ---
const TYPE_META = {
  pdf: { glyph: "↓", kicker: "Download · PDF", action: "Download PDF →" },
  external: { glyph: "↗", kicker: "External link", action: "Visit site ↗" },
  post: { glyph: "→", kicker: "Read on site", action: "Read post →" },
} as const;

// --- Catalog = resources + non-draft posts, unified into one card shape ---
const resourceEntries = await getCollection("resources");
const postEntries = (await getCollection("posts")).filter((p) => !p.data.draft);

type Card = {
  title: string;
  description: string;
  cats: string[];
  type: keyof typeof TYPE_META;
  href: string;
  newTab: boolean;
  inert: boolean;
  glyph: string;
  kicker: string;
  action: string;
};

// Link targets + the inert "/resources/PLACEHOLDER-" convention live in
// src/lib/resources.ts (shared with the Nav's featured rail).

const resourceCards: Card[] = resourceEntries.map((e) => {
  const type = e.data.type as keyof typeof TYPE_META;
  const cats = e.data.categories.map((c: { id: string }) => c.id);
  return {
    title: e.data.title,
    description: e.data.description,
    cats,
    type,
    ...resourceTarget(e), // href / newTab / inert (a hosted PDF's action shows ↗)
    ...TYPE_META[type],
    ...(type === "pdf" && !e.data.file ? { action: "Download PDF ↗" } : {}),
  };
});

const postCards: Card[] = postEntries.map((e) => ({
  title: e.data.title,
  description: e.data.description,
  cats: e.data.categories.map((c: { id: string }) => c.id),
  type: "post",
  href: `/resources/${e.id}`,
  newTab: false,
  inert: false,
  ...TYPE_META.post,
}));

// Deterministic order: alphabetical by title (no curated sort field yet).
const catalog: Card[] = [...resourceCards, ...postCards].sort((a, b) =>
  a.title.localeCompare(b.title),
);

const totalCount = catalog.length;
const countFor = (id: string) => catalog.filter((c) => c.cats.includes(id)).length;

// --- Featured card (hero, right column) — brand/prototype/FEATURED-RESOURCE-PHOTO-SPEC.md ---
// Which item + its wording come from src/lib/resources.ts (shared with the Nav rail).
// None featured → no card, and the hero stays single-column. The kit's Format/Led
// by/Category row is deliberately NOT built (no such fields; Todd, 2026-09-26).
const feat = await getFeaturedResource();

// --- Generated :target filter engine (injected is:global below) ---
// Kept global (not scoped) so the #id:target sibling selectors are not rewritten by
// Astro's scoping, and so the active-chip rules win predictably. The chips are styled
// here too (rather than scoped) so their base + active states share one specificity
// origin. scroll-margin-top clears our sticky Nav (~72px) with breathing room.
const NAV_CLEARANCE = 96;
const list = (fn: (id: string) => string) => catIds.map(fn).join(",\n");
const filterCss = `
.tgt { display: block; height: 0; scroll-margin-top: ${NAV_CLEARANCE}px; }

.chip {
  font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--ink-2);
  padding: 8px 15px; border: 1px solid var(--line-strong);
  border-radius: var(--radius-pill);
  background: var(--bg); /* stays light on the shaded --bg-2 chips band */
  transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
}
.chip:hover { border-color: var(--ink-3); }
.chip .n { color: var(--ink-4); margin-left: 7px; }
.chip-all { background: var(--ink); color: var(--bg); border-color: var(--ink); }

${list((id) => `#${id}:target ~ .filter-bar .chip-all`)} {
  background: var(--bg); color: var(--ink-2); border-color: var(--line-strong);
}
${list((id) => `#${id}:target ~ .filter-bar .chip-${id}`)} {
  background: var(--ink); color: var(--bg); border-color: var(--ink);
}
${list((id) => `#${id}:target ~ .catalog-wrap .card:not(.cat-${id})`)} {
  display: none;
}
.count .active-name { display: none; }
.count .all-name { display: inline; }
${list((id) => `#${id}:target ~ .catalog-wrap .count .all-name`)} { display: none; }
${list((id) => `#${id}:target ~ .catalog-wrap .count .name-${id}`)} { display: inline; }

@media (max-width: 720px) { .chip { font-size: 14px; } }
`;
---

<Layout
  title="Resources"
  description="The North Wake Church resource library — forms, reading plans, guides, and staff-written pages, filterable by category."
>
  <!-- Breadcrumb first in body (Resources = current filled chip). -->
  <Breadcrumb trail={[{ label: "Home", href: "/" }, { label: "Resources" }]} />

  <!-- Hero — UNVERIFIED placeholder copy carried from the design package. -->
  <section class="rz-hero">
    <div class={`wrap${feat ? " rz-hero-grid" : ""}`}>
      <div>
        <div class="eyebrow rz-eyebrow"><span class="dot"></span>Resources</div>
        <h1 class="display-l rz-title">A shelf for the whole church family.</h1>
        <p class="lede rz-lede">
          Forms, reading plans, guides, and pages written by our staff — gathered in one
          place. Scan the list, download what you need, follow a link, or read it right here.
        </p>
      </div>
      {
        feat && (
          // ONE link wraps the card; the button is a <span> so links never nest.
          <a
            class="feat"
            href={feat.href}
            aria-labelledby="feat-title"
            {...(feat.newTab ? { target: "_blank", rel: "noopener" } : {})}
          >
            <Image
              src={featuredPhoto}
              alt=""
              class="feat-photo"
              loading="eager"
              width={1200}
              widths={[480, 800, 1200]}
              sizes="(max-width: 960px) 100vw, 520px"
            />
            <div class="feat-top">
              <span class="feat-kicker">Featured resource</span>
              <span class="feat-type">{TYPE_META[feat.type].kicker}</span>
            </div>
            <h2 class="feat-title" id="feat-title">{feat.title}</h2>
            <p class="feat-desc">{feat.blurb}</p>
            <span class="btn btn-on-image-primary feat-cta">
              {feat.ctaLabel} <span class="arr" aria-hidden="true">{feat.ctaArr}</span>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <!-- filter + catalog root: tgt anchors → filter bar → catalog (sibling order is
       what makes the :target ~ combinator reach forward). -->
  <div class="filter-root wrap">
    <a id="all" class="tgt"></a>
    {categories.map((c) => <a id={c.id} class="tgt"></a>)}

    <div class="filter-bar">
      <!-- Search (ADR 0002). Ships `hidden`; the inline script at the end of this page
           reveals it, so a no-JS visitor never sees a box that does nothing. -->
      <div class="search-row" data-rz-search hidden>
        <label class="search-label" for="rz-q">Search</label>
        <input
          id="rz-q"
          class="search-input"
          type="search"
          placeholder="Search resources"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div class="chips">
        <span class="chips-label">Filter</span>
        <a href="#all" class="chip chip-all">All <span class="n">{totalCount}</span></a>
        {
          categories.map((c) => (
            <a href={`#${c.id}`} class={`chip chip-${c.id}`}>
              {c.label} <span class="n">{countFor(c.id)}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="catalog-wrap">
      <div class="catalog-head">
        <span class="eyebrow"><span class="dot"></span>Library</span>
        <span class="count cat-count">
          Showing <span class="all-name">all resources</span>{
            categories.map((c) => (
              <span class={`active-name name-${c.id}`}>{c.label}</span>
            ))
          }
        </span>
        <!-- Search result count; empty (and so silent) until someone types. -->
        <span class="count search-status" aria-live="polite"></span>
      </div>

      <div class="catalog">
        {
          catalog.map((it) => {
            // Inert placeholder rows are a <div> (no link); live rows are an <a>.
            const Tag = it.inert ? "div" : "a";
            const linkProps = it.inert
              ? {}
              : { href: it.href, ...(it.newTab ? { target: "_blank", rel: "noopener" } : {}) };
            return (
              <Tag
                class={`card${it.inert ? " is-inert" : ""} ${it.cats.map((id) => `cat-${id}`).join(" ")}`}
                {...linkProps}
              >
                <span class="card-type"><span class="glyph">{it.glyph}</span></span>
                <div class="card-main">
                  <h3><span class="type-kicker">{it.kicker}</span>{it.title}</h3>
                  <p>{it.description}</p>
                </div>
                <div class="card-tags">
                  {it.cats.map((id) => <span class="tag">{labelOf[id]}</span>)}
                </div>
                {it.inert ? (
                  <span class="card-action card-soon">Available soon</span>
                ) : (
                  <span class="card-action">{it.action}</span>
                )}
              </Tag>
            );
          })
        }
      </div>

      <!-- Search empty state (ADR 0002) — shown by the script only. -->
      <div class="search-empty" data-rz-empty hidden>
        <p>Nothing here matches that search.</p>
        <div class="search-empty-actions">
          <button type="button" class="btn btn-ghost" data-rz-clear>Clear search</button>
          <a class="btn btn-ghost" href="#all" data-rz-all hidden>Search all categories</a>
        </div>
      </div>
    </div>
  </div>

  <!-- DOCUMENTED EXCEPTION #3 — docs/adr-0002-resources-search.md. First-party, inline,
       no library, no network, nothing stored or sent. Filters the rows already in the
       HTML by their text (title, description, kicker, category tags); the CSS :target
       category filter keeps working independently, so a visible row matches both.
       is:inline keeps Astro from bundling it. Stay inside the ADR's limits. -->
  <script is:inline>
    (() => {
      const box = document.querySelector("[data-rz-search]");
      const input = document.getElementById("rz-q");
      const root = document.querySelector(".filter-root");
      const status = root.querySelector(".search-status");
      const empty = root.querySelector("[data-rz-empty]");
      const allLink = root.querySelector("[data-rz-all]");
      // Case- and accent-insensitive.
      const norm = (s) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
      const rows = [...root.querySelectorAll(".catalog .card")].map((el) => ({
        el,
        text: norm(el.textContent),
      }));

      const run = () => {
        const q = input.value.trim();
        // Words of 5+ letters drop a plural-ish ending so singular and plural meet:
        // "family" and "families" both → "famil"; "parents" → "parent" (finds "Parenting").
        const words = norm(q)
          .split(/\s+/)
          .filter(Boolean)
          .map((w) => (w.length >= 5 ? w.replace(/(ies|es|s|y)$/, "") : w));
        // Every typed word must appear in the row.
        rows.forEach((r) => (r.el.hidden = !words.every((w) => r.text.includes(w))));
        const searching = words.length > 0;
        root.classList.toggle("is-searching", searching);
        // Visible = not hidden by search AND not hidden by the category filter.
        const shown = rows.filter((r) => r.el.offsetParent !== null).length;
        status.textContent = !searching
          ? ""
          : shown === 0
            ? "No resources match"
            : `${shown} ${shown === 1 ? "resource matches" : "resources match"}`;
        empty.hidden = !searching || shown > 0;
        const inCategory = location.hash.length > 1 && location.hash !== "#all";
        allLink.hidden = !inCategory;
      };

      input.addEventListener("input", run);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          input.value = "";
          run();
        }
      });
      root.querySelector("[data-rz-clear]").addEventListener("click", () => {
        input.value = "";
        run();
        input.focus();
      });
      window.addEventListener("hashchange", run);
      box.hidden = false;
      run(); // a query the browser restored on Back is applied immediately
    })();
  </script>
</Layout>

<!-- Structural CSS (scoped). Colors via semantic tokens only; the package :root is
     dropped (Layout → global.css → tokens.css supplies them). -->
<style>
  .rz-hero {
    padding: 72px 0 8px;
  }
  .rz-title {
    max-width: 16ch;
    margin-top: 26px;
  }
  .rz-lede {
    max-width: 54ch;
    margin-top: 24px;
    color: var(--ink-2);
  }

  /* ---- Featured card (brand/prototype/FEATURED-RESOURCE-PHOTO-SPEC.md) ----
     Translated onto the site's tokens: the kit's [data-theme="dim"] is NOT used (dropped
     site-wide); on-photo text uses the on-image / inverse semantics instead. */
  .rz-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 64px;
    align-items: end; /* card bottom-aligns with the lede */
  }
  .feat {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    padding: 34px 32px 32px;
    background: var(--bg-inverse); /* shows only if the photo fails */
    color: var(--on-image-fg);
  }
  .feat :global(.feat-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    z-index: 0;
  }
  /* DOCUMENTED page-local literal exception: real-image scrim (rgba of ink-900
     #1a1814). 86–94% charcoal from ~60% down where the title/desc/button sit — cream
     text stays well above AA wherever the ridgeline falls. DEVIATION from the kit: the
     kit's 35% top stop left the 11px kicker/type labels at ~1.5:1 over bright cloud, so
     a 0.75 band covers the label row (0–12%) before easing to the kit's sky-showing
     middle. */
  .feat::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(26, 24, 20, 0.75) 0%,
      rgba(26, 24, 20, 0.7) 12%,
      rgba(26, 24, 20, 0.4) 24%,
      rgba(26, 24, 20, 0.55) 38%,
      rgba(26, 24, 20, 0.86) 62%,
      rgba(26, 24, 20, 0.94) 100%
    );
    transition: opacity 200ms ease;
  }
  /* Content above the scrim (named, not :not(), which doesn't survive Astro scoping). */
  .feat-top,
  .feat-title,
  .feat-desc,
  .feat-cta {
    position: relative;
    z-index: 2;
  }
  .feat:hover::before {
    opacity: 0.92; /* photo brightens slightly */
  }
  .feat:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .feat-top {
    display: flex;
    flex-wrap: wrap; /* at the phone mono bump (14px) the type label drops to line 2 */
    justify-content: space-between;
    gap: 8px 16px;
    white-space: nowrap; /* never break a label mid-phrase */
    margin-bottom: auto; /* pins title/desc/button to the bottom */
    padding-bottom: 40px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .feat-kicker {
    color: var(--on-image-accent);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .feat-kicker::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--on-image-accent);
  }
  .feat-type {
    color: var(--ink-on-inverse-2);
  }
  .feat-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(30px, 2.8vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
  }
  .feat-desc {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-on-inverse-2);
    margin: 0 0 22px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .feat-cta {
    align-self: flex-start; /* stays a pill, never stretched */
    white-space: nowrap;
  }
  /* The whole card is the link, so card hover drives the button state. */
  .feat:hover .feat-cta {
    background: var(--on-image-accent);
  }
  .feat:hover .feat-cta .arr {
    transform: translateX(3px);
  }
  @media (max-width: 960px) {
    .rz-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .feat {
      min-height: 460px;
    }
  }
  @media (max-width: 560px) {
    .feat {
      min-height: 420px;
      padding: 26px 20px 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feat::before,
    .feat-cta,
    .feat-cta .arr {
      transition: none;
    }
  }

  .filter-root {
    padding-top: 40px;
  }

  /* full-bleed to the .wrap edges (its gutter is 40px desktop, 22px ≤720) */
  .filter-bar {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 12px -40px 0;
  }
  /* Search row (ADR 0002) — sits above the chips inside the same full-bleed bar. */
  .search-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 40px; /* same gutter re-align as .chips */
    border-bottom: 1px solid var(--line);
  }
  .search-row[hidden] {
    display: none; /* display:flex above would otherwise beat the hidden attribute */
  }
  .search-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent); /* clay, so the search box reads as the first thing to use */
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    max-width: 520px;
    font: inherit;
    font-size: 16px; /* content floor; also stops iOS zooming on focus */
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
  }
  .search-input::placeholder {
    color: var(--ink-4);
  }
  .search-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--ink-3);
  }

  /* While searching, the text count replaces the category count. */
  .search-status:empty,
  .filter-root.is-searching .cat-count {
    display: none;
  }
  /* .card sets display:grid, which would otherwise beat the hidden attribute. */
  .card[hidden] {
    display: none;
  }
  /* While searching, the page-bottom space moves from the list to its wrapper so the
     empty state (which sits after the list) doesn't open an 80px gap above itself. */
  .filter-root.is-searching .catalog {
    margin-bottom: 0;
  }
  .filter-root.is-searching .catalog-wrap {
    padding-bottom: 80px;
  }
  .search-empty {
    padding-top: 48px;
  }
  .search-empty[hidden] {
    display: none;
  }
  .search-empty p {
    font-size: 18px;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .search-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .search-empty-actions [hidden] {
    display: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 14px 40px; /* re-align chips to the gutter */
    background: var(--bg-2); /* shaded band separates the chips from the search row */
  }
  .chips-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-right: 8px;
  }

  .catalog-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 40px 0 20px;
    gap: 20px;
  }
  .count {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: right;
  }

  .catalog {
    border-top: 1px solid var(--line-strong);
    margin-bottom: 80px;
  }

  /* ROW: glyph | title+desc | tags | action */
  .card {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 220px 150px;
    align-items: center;
    gap: 32px;
    padding: 26px 12px;
    border-bottom: 1px solid var(--line);
    color: inherit;
    background: var(--bg);
    transition: background 120ms ease;
  }
  .card:hover {
    background: var(--bg-2);
  }
  /* Inert (placeholder) row — non-clickable, no hover affordance. */
  .card.is-inert {
    cursor: default;
  }
  .card.is-inert:hover {
    background: var(--bg);
  }
  .card-soon {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .card-type .glyph {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 18px;
    color: var(--accent);
  }
  .card-main {
    min-width: 0;
  }
  .card h3 {
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 5px;
  }
  .type-kicker {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
