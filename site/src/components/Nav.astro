---
// Top navigation chrome — full-width MEGA-MENU variant.
// Each group trigger opens a single full-bleed .mega panel anchored to .nav
// (columns of items + a featured rail). Static, zero-JS: panels open on
// :hover / :focus-within only; active state is computed at build time from
// Astro.url.pathname. Brand mark, direct links, and CTAs preserved from the
// prior nav. All CSS scoped here; consumes only global tokens + .btn*.

import { Image } from "astro:assets";
import { BUSINESS } from "../data/business";
// The church's logo mark (Todd, 2026-09-26). Transparent background (the cross gaps
// too), so it sits on any band. Footer still uses the CSS placeholder mark.
import brandMark from "../assets/brand/nw-mark.webp";
import { getFeaturedResource } from "../lib/resources";

const pathname = Astro.url.pathname;

// Normalize trailing slash so "/visit/" and "/visit" both match.
const norm = (p: string) => (p !== "/" && p.endsWith("/") ? p.slice(0, -1) : p);
const here = norm(pathname);
const isActive = (href: string) => norm(href) === here;

type MegaItem = { label: string; href?: string; desc: string };
type MegaColumn = { heading: string; items: MegaItem[] };
type MegaGroup = {
  label: string;
  columns: MegaColumn[];
  featured: {
    kicker: string;
    title: string;
    body: string;
    ctaLabel: string;
    ctaHref: string;
    ctaArr?: string; // default "→"; "↗" for an item that opens another site
    newTab?: boolean;
  };
};

// Resources rail: the item staff feature in Pages CMS (the same one as the /resources
// hero card — src/lib/resources.ts). None featured → the default sermons rail below.
const featuredResource = await getFeaturedResource();

// UNVERIFIED COPY — descriptions + featured rails are placeholders, confirm with church before launch.
// Items WITHOUT an href are unbuilt routes → rendered dimmed/non-clickable, no arrow.
const GROUPS: MegaGroup[] = [
  {
    label: "About",
    columns: [
      {
        heading: "Who We Are",
        items: [
          { label: "Our Beliefs", href: "/about/beliefs", desc: "What we hold to and why." },
          { label: "Mission & Vision", href: "/about/mission", desc: "Who we are and where we're going." },
        ],
      },
      {
        heading: "Get Involved",
        items: [
          { label: "Leadership", desc: "The team who shepherds North Wake." },
          { label: "Membership", href: "/about/membership", desc: "Make North Wake your church home." },
        ],
      },
    ],
    featured: {
      kicker: "New here?",
      title: "Start with Jesus.",
      body: "Curious, questioning, or skeptical — here's a place to begin.",
      ctaLabel: "Who is Jesus?",
      ctaHref: "/who-is-jesus",
    },
  },
  {
    label: "Mission",
    columns: [
      {
        heading: "Reach",
        items: [
          { label: "International Missions", href: "/mission/international", desc: "The gospel to the nations." },
          { label: "Church Planting", href: "/mission/church-planting", desc: "New churches, near and far." },
          { label: "Local Outreach", desc: "Loving Wake Forest in word and deed." },
        ],
      },
      {
        heading: "Equip & Serve",
        items: [
          { label: "Ministry Training", href: "/mission/training", desc: "Equipping the saints for the work." },
          { label: "Serve the Church", desc: "Find your place to give and grow." },
        ],
      },
    ],
    featured: {
      kicker: "Go in love",
      title: "Be sent.",
      body: "From Wake Forest to the nations — find your place in the mission.",
      ctaLabel: "Get involved",
      ctaHref: "/community/grow-groups",
    },
  },
  {
    label: "Help",
    columns: [
      {
        heading: "Counseling & Care",
        items: [
          { label: "Hope Counseling", href: "/help/hope-counseling", desc: "Biblical counseling for hard seasons." },
          { label: "Care Ministry", href: "/help/care", desc: "Practical help when life is heavy." },
        ],
      },
      {
        heading: "Health & Provision",
        items: [
          { label: "Mercy Health Clinic", href: "/help/mercy-clinic", desc: "Free medical and dental care for neighbors in need." },
          { label: "Feed Ministry", href: "/help/feed", desc: "Groceries and dignity for neighbors in need." },
        ],
      },
    ],
    featured: {
      kicker: "Need help now?",
      title: "You don't walk alone.",
      body: "Reach our care team and someone will follow up personally.",
      ctaLabel: "Talk to someone",
      ctaHref: "/help/hope-counseling",
    },
  },
  {
    label: "Community",
    columns: [
      {
        heading: "Groups & Classes",
        items: [
          { label: "Grow Groups", href: "/community/grow-groups", desc: "Weekly community in homes across Wake Forest." },
          { label: "Adult Discipleship", desc: "Sunday classes for every season of faith." },
        ],
      },
      {
        heading: "Next Generation",
        items: [
          { label: "Kids", href: "/community/kids", desc: "Birth–5th grade, every Sunday." },
          { label: "Students", href: "/community/students", desc: "6th–12th grade, midweek & Sundays." },
          { label: "LILY Moms", href: "/community/lily-moms", desc: "Encouragement for moms of little ones." },
        ],
      },
      {
        heading: "Men, Women & Life Stage",
        items: [
          { label: "Women", href: "/community/women", desc: "Studies, retreats, friendship." },
          { label: "Men", desc: "Breakfasts and book studies." },
          { label: "Young Adults", desc: "20s & 30s doing life together." },
          { label: "Mature Adults", href: "/community/mature-adults", desc: "Fellowship, faith, and fun." },
        ],
      },
    ],
    featured: {
      kicker: "New here?",
      title: "Find your people.",
      body: "Tell us your season of life and we'll match you to a group.",
      ctaLabel: "Get connected",
      ctaHref: "/community/grow-groups",
    },
  },
  {
    label: "Resources",
    columns: [
      {
        heading: "Watch & Read",
        items: [
          { label: "Sermons", href: "/sermons", desc: "Catch up on the latest series." },
          { label: "Blog", href: "/blog", desc: "Writing from our pastors and team." },
        ],
      },
      {
        heading: "Stay Connected",
        items: [
          { label: "Events", href: "/events", desc: "What's coming up at North Wake." },
          { label: "Other Resources", href: "/resources", desc: "Reading, links, and downloads." },
        ],
      },
    ],
    featured: featuredResource
      ? {
          kicker: "Featured resource",
          title: featuredResource.title,
          body: featuredResource.blurb,
          ctaLabel: featuredResource.ctaLabel,
          ctaHref: featuredResource.href,
          ctaArr: featuredResource.ctaArr,
          newTab: featuredResource.newTab,
        }
      : {
          kicker: "This Sunday",
          title: "Catch the latest.",
          body: "Miss a week? Watch the most recent sermon any time.",
          ctaLabel: "Watch now",
          ctaHref: "/sermons", // sermons now live; rail copy stays UNVERIFIED placeholder
        },
  },
];

const groupActive = (g: MegaGroup) =>
  g.columns.some((col) => col.items.some((it) => it.href && isActive(it.href)));

const GIVE_HREF = BUSINESS.givingUrl;
---

<nav class="nav">
  <div class="nav-inner">
    {/* Logo mark = the real asset; the text wordmark stays until a full logo lockup
        exists. alt="" — the link's aria-label names it. */}
    <a class="brand" href="/" aria-label="North Wake Church — home">
      <Image
        src={brandMark}
        alt=""
        class="brand-mark"
        width={26}
        height={26}
        densities={[1, 2, 3]}
        loading="eager"
      />
      <span class="brand-name">North <span class="accent">Wake</span><span class="brand-church"> Church</span></span>
    </a>

    <div class="nav-links">
      <a class={`nav-link${isActive("/") ? " active" : ""}`} href="/">Home</a>

      {
        GROUPS.map((g) => (
          <div class="nav-item">
            <button
              type="button"
              class={`nav-link nav-trigger${groupActive(g) ? " active" : ""}`}
              aria-haspopup="true"
            >
              {g.label}
              <span class="caret" aria-hidden="true"></span>
            </button>

            <div class="mega" role="menu">
              <div class={`mega-inner cols-${g.columns.length}`}>
                {g.columns.map((col) => (
                  <div class="mega-col">
                    <div class="mega-heading">{col.heading}</div>
                    {col.items.map((it) =>
                      it.href ? (
                        <a
                          class={`mega-item${isActive(it.href) ? " active" : ""}`}
                          href={it.href}
                          role="menuitem"
                        >
                          <span class="mega-item-row">
                            <span class="mega-item-label">{it.label}</span>
                            <span class="mega-item-arr" aria-hidden="true">→</span>
                          </span>
                          <span class="mega-item-desc">{it.desc}</span>
                        </a>
                      ) : (
                        <div class="mega-item is-dimmed" aria-disabled="true">
                          <span class="mega-item-row">
                            <span class="mega-item-label">{it.label}</span>
                          </span>
                          <span class="mega-item-desc">{it.desc}</span>
                        </div>
                      )
                    )}
                  </div>
                ))}

                <aside class="mega-featured">
                  <div class="mega-featured-kicker">{g.featured.kicker}</div>
                  <div class="mega-featured-title">{g.featured.title}</div>
                  <p class="mega-featured-body">{g.featured.body}</p>
                  <a
                    class="btn btn-primary mega-featured-cta"
                    href={g.featured.ctaHref}
                    {...(g.featured.newTab ? { target: "_blank", rel: "noopener" } : {})}
                  >
                    {g.featured.ctaLabel} <span class="arr">{g.featured.ctaArr ?? "→"}</span>
                  </a>
                </aside>
              </div>
            </div>
          </div>
        ))
      }

      <a class={`nav-link${isActive("/visit") ? " active" : ""}`} href="/visit">Come Visit</a>
      <a class={`nav-link${isActive("/who-is-jesus") ? " active" : ""}`} href="/who-is-jesus">Who is Jesus</a>
    </div>

    <div class="nav-cta">
      <a class="btn btn-ghost nav-give" href={GIVE_HREF} target="_blank" rel="noopener">Give</a>
      <a class="btn btn-primary nav-visit" href="/visit">
        Plan a Visit
        <span class="arr">→</span>
      </a>
    </div>

    {/* MOBILE NAV — CSS-only hamburger (≤1180px). Renders from the SAME GROUPS
        source as the desktop mega, plus the same direct links + givingUrl, so
        content can never drift from desktop. Zero JS: native <details>/<summary>
        disclosure. Hidden above 1180px (see the media query below). */}
    <details class="mnav">
      <summary class="mnav-toggle" aria-label="Menu">
        <span class="mnav-icon" aria-hidden="true"></span>
      </summary>
      <div class="mnav-panel">
        <a class="btn btn-ghost mnav-give" href={GIVE_HREF} target="_blank" rel="noopener">Give</a>
        <a class={`mnav-link${isActive("/") ? " active" : ""}`} href="/">Home</a>

        {GROUPS.map((g) => (
          <details class="mnav-group">
            <summary class="mnav-group-summary">
              <span>{g.label}</span>
              <span class="mnav-caret" aria-hidden="true"></span>
            </summary>
            <div class="mnav-group-items">
              {g.columns
                .flatMap((col) => col.items)
                .map((it) =>
                  it.href ? (
                    <a class={`mnav-sublink${isActive(it.href) ? " active" : ""}`} href={it.href}>
                      {it.label}
                    </a>
                  ) : (
                    <div class="mnav-sublink is-dimmed" aria-disabled="true">
                      {it.label}
                    </div>
                  )
                )}
            </div>
          </details>
        ))}

        <a class={`mnav-link${isActive("/visit") ? " active" : ""}`} href="/visit">Come Visit</a>
        <a class={`mnav-link${isActive("/who-is-jesus") ? " active" : ""}`} href="/who-is-jesus">Who is Jesus</a>
      </div>
    </details>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0; /* never let the wordmark compress at narrow widths */
  }
  .brand :global(.brand-mark) {
    display: block;
    width: 26px;
    height: 26px;
    flex: none;
  }
  .brand-name {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.02em; /* opened up for all caps (was -0.012em mixed case) */
    text-transform: uppercase; /* NORTH WAKE CHURCH — Todd, 2026-09-26 */
    color: var(--ink);
    white-space: nowrap; /* the wordmark stays on one line at any width */
  }
  .brand-name .accent {
    color: var(--accent);
  }
  /* "CHURCH" only where the nav has room (Todd, 2026-09-26). The full caps wordmark
     needs ~1244px for a one-line desktop nav, and on phones it crushed "Plan a Visit".
     The link's aria-label still says "North Wake Church" at every width. */
  .brand-church {
    display: none;
  }
  @media (min-width: 1260px) {
    .brand-church {
      display: inline;
    }
  }
  /* Smallest phones: caps at 17px pushed "Plan a Visit" to 3 lines at 320px; 15px
     restores the prior fit. */
  @media (max-width: 360px) {
    .brand-name {
      font-size: 15px;
      letter-spacing: 0;
    }
  }

  /* Links row */
  .nav-links {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .nav-link {
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    border-radius: var(--radius-pill);
    letter-spacing: -0.005em;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-2);
  }
  .nav-link.active {
    color: var(--ink);
    background: var(--bg-2);
  }

  /* Dropdown trigger is a <button> for a11y; strip native chrome to match links */
  .nav-trigger {
    background: transparent;
    border: 0;
    cursor: default;
    font-family: inherit;
  }
  .caret {
    width: 8px;
    height: 8px;
    border-right: 1.4px solid currentColor;
    border-bottom: 1.4px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    opacity: 0.5;
    transition: transform 200ms ease;
  }

  /* -------------------------------------------------------------------------
   * MEGA PANEL — full-bleed, anchored to .nav (which is the positioned/sticky
   * containing block). .nav-item is NOT positioned, so the panel resolves to
   * .nav and spans left:0/right:0 (full width, no 100vw / no negative margins).
   * Opens on hover / focus-within of its .nav-item. Zero JS.
   * ----------------------------------------------------------------------- */
  .nav-item {
    /* intentionally static — lets .mega anchor to .nav, not the item */
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line-strong);
    box-shadow: var(--shadow-dropdown);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
  }
  /* Hover-bridge: transparent strip from the panel up across the bar's lower
     padding, so the cursor keeps .nav-item:hover while descending from the
     trigger into the panel. Only present while this item's panel is open. */
  .mega::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 16px;
  }
  .nav-item:hover .mega,
  .nav-item:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav-item:hover .caret,
  .nav-item:focus-within .caret {
    transform: rotate(225deg) translateY(1px);
  }

  .mega-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 40px; /* 40px gutter matches .nav-inner so columns align under the bar */
    display: grid;
    gap: 36px;
  }
  /* one 1fr per content column + a 0.9fr featured rail */
  .mega-inner.cols-2 {
    grid-template-columns: repeat(2, 1fr) 0.9fr;
  }
  .mega-inner.cols-3 {
    grid-template-columns: repeat(3, 1fr) 0.9fr;
  }

  .mega-col {
    display: flex;
    flex-direction: column;
  }
  .mega-heading {
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-4);
    padding-bottom: 8px;
  }

  .mega-item {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    color: inherit;
    transition: background 140ms ease;
  }
  .mega-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .mega-item-label {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .mega-item-arr {
    color: var(--accent);
    font-size: 13px;
    opacity: 0.55;
    transition: opacity 140ms ease;
  }
  .mega-item-desc {
    display: block;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-3);
    margin-top: 3px;
  }
  a.mega-item:hover,
  .mega-item.active {
    background: var(--bg-2);
  }
  a.mega-item:hover .mega-item-arr,
  .mega-item.active .mega-item-arr {
    opacity: 1;
  }
  /* Dimmed (unbuilt route): non-clickable, muted, no arrow, no hover bg. */
  .mega-item.is-dimmed {
    cursor: default;
  }
  .mega-item.is-dimmed .mega-item-label {
    color: var(--ink-4);
  }

  /* Featured rail */
  .mega-featured {
    background: var(--bg-2);
    border-radius: 10px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .mega-featured-kicker {
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-4);
    padding-bottom: 10px;
  }
  .mega-featured-title {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.2;
    color: var(--ink);
  }
  .mega-featured-body {
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-3);
    /* bottom 20px = guaranteed floor so the CTA never jams against short bodies
       (e.g. Resources); .mega-featured-cta margin-top:auto still bottom-pins
       on taller rails. */
    margin: 10px 0 20px;
    /* A featured resource's blurb is staff-written — cap it so the rail never grows. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  .mega-featured-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* CTA cluster */
  .nav-cta {
    display: flex;
    gap: 8px;
  }
  .nav-cta .btn {
    padding: 10px 18px;
    font-size: 13px;
  }

  /* =========================================================================
   * MOBILE NAV (≤1180px) — CSS-only hamburger via native <details>/<summary>.
   * Zero JS. Hidden by default (desktop); revealed in the media query below.
   * .mnav stays position:static so .mnav-panel anchors to .nav (the sticky
   * positioned ancestor) and spans full-bleed — same trick as .mega.
   * ========================================================================= */
  .mnav {
    display: none;
    position: static;
  }

  /* Hamburger trigger — a 44px tap target; native marker suppressed. */
  .mnav-toggle {
    list-style: none; /* suppress native disclosure marker (spec-compliant path) */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mnav-toggle::-webkit-details-marker {
    display: none; /* suppress native marker (WebKit/Blink) */
  }

  /* Three-bar icon: center bar = the span; ::before/::after = outer bars. */
  .mnav-icon,
  .mnav-icon::before,
  .mnav-icon::after {
    content: "";
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 200ms ease, background 200ms ease;
  }
  .mnav-icon {
    position: relative;
  }
  .mnav-icon::before {
    position: absolute;
    top: -7px;
    left: 0;
  }
  .mnav-icon::after {
    position: absolute;
    top: 7px;
    left: 0;
  }
  /* [open] → X: center bar disappears, outer bars cross at center. */
  .mnav[open] .mnav-icon {
    background: transparent;
  }
  .mnav[open] .mnav-icon::before {
    transform: translateY(7px) rotate(45deg);
  }
  .mnav[open] .mnav-icon::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Panel — full-bleed overlay dropping below the bar; scrolls internally so a
     fully expanded accordion never pushes page content or exceeds the viewport.
     Bar height at ≤1180px is ~72px (44px summary + 2×14px padding, set below). */
  .mnav-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line-strong);
    box-shadow: var(--shadow-dropdown);
    /* COUPLED to the ≤1180px .nav-inner padding: 14px top+bottom + the 44px
       .mnav-toggle summary = 72px bar height. This 72px MUST equal that sum so
       the panel bottom lands exactly at the viewport edge. Change one → change both. */
    max-height: calc(100vh - 72px);
    overflow-y: auto;
    padding: 12px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Give — full-width row at the top of the panel. */
  .mnav-give {
    width: 100%;
    justify-content: center;
    margin-bottom: 10px;
  }

  /* Top-level rows: Home, Come Visit, Who is Jesus (≥44px tap height, 16px text). */
  .mnav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 12px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    border-radius: 8px;
  }
  .mnav-link.active {
    background: var(--bg-2);
  }

  /* Group accordion — one <details> per group; siblings may be open together. */
  .mnav-group {
    border-top: 1px solid var(--line);
  }
  .mnav-group:first-of-type {
    border-top: 0;
  }
  .mnav-group-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 10px 12px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }
