---
// Site footer chrome. Translated from brand/prototype/shell.jsx (Footer) +
// brand/prototype/styles.css (.footer*). Static, zero-JS. NAP/contact values
// come from the single source of truth in src/data/business.ts — never hardcoded.
import { Image } from "astro:assets";
import { BUSINESS } from "../data/business";
// Same logo mark as the Nav (Todd, 2026-09-26).
import brandMark from "../assets/brand/nw-mark.webp";

// Honest-placeholder rule: founding year is unverified, so the prototype's
// "Est. 19##" is dropped in favor of the location only.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        {/* Logo mark + caps wordmark, matching the Nav (the footer always has room
            for "CHURCH"). Known duplication with Nav.astro's brand block — extract
            a shared Brand component if a third consumer appears. */}
        <a class="brand" href="/" aria-label="North Wake Church — home">
          <Image
            src={brandMark}
            alt=""
            class="brand-mark"
            width={30}
            height={30}
            densities={[1, 2, 3]}
          />
          <span class="brand-name"><span class="nw">North <span class="accent">Wake</span></span> <span class="nw">Church</span></span>
        </a>
        <p class="body blurb">
          A family of faith in Wake Forest, North Carolina — knowing, growing,
          and going in the love of Jesus Christ.
        </p>
        <div class="footer-actions">
          {/* TODO: Subscribe has no newsletter form/route yet — inert button
              for now; wire to a real signup in a later step. */}
          <button type="button" class="btn btn-ghost">Subscribe</button>
          <a class="btn btn-primary" href="/visit">Plan a Visit</a>
        </div>
      </div>

      <div>
        <h5>Visit</h5>
        <ul>
          <li><a href="/visit">Service Times</a></li>
          <li class="static">What to Expect</li>
          <li class="static">Directions</li>
          <li class="static">Kids &amp; Students</li>
          <li class="static">Parking</li>
        </ul>
      </div>

      <div>
        <h5>Belong</h5>
        <ul>
          <li><a href="/community/grow-groups">Grow Groups</a></li>
          <li><a href="/about/membership">Membership</a></li>
          <li><a href="/community/adult-discipleship">Adult Discipleship</a></li>
          <li><a href="/community/women">Women's Ministry</a></li>
          <li><a href="/community/men">Men's Ministry</a></li>
        </ul>
      </div>

      <div>
        <h5>Care</h5>
        <ul>
          <li><a href="/help/hope-counseling">Hope Counseling</a></li>
          <li><a href="/help/mercy-clinic">Mercy Health Clinic</a></li>
          <li><a href="/help/feed">Feed Ministry</a></li>
          <li><a href="/help/care">Care Ministry</a></li>
          <li class="static">Prayer Requests</li>
        </ul>
      </div>

      <div>
        <h5>Connect</h5>
        <ul>
          <li><a href="/sermons">Sermons</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/events">Events</a></li>
          <li class="static">Contact</li>
          <li>
            <a href={BUSINESS.givingUrl} target="_blank" rel="noopener">Give</a>
          </li>
        </ul>
        <div class="contact">
          <div>
            <div class="mono label">Address</div>
            <div class="small value">
              {BUSINESS.streetAddress}<br />
              {BUSINESS.city}, {BUSINESS.state} {BUSINESS.postalCode}
            </div>
          </div>
          <div>
            <div class="mono label">Phone</div>
            <div class="small value">{BUSINESS.phone}</div>
          </div>
          <div>
            <div class="mono label">Email</div>
            <div class="small value">{BUSINESS.email}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} North Wake Church · A family of faith</span>
      <span class="mono">Wake Forest, NC</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    padding: 80px 0 32px;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 48px;
    padding-bottom: 64px;
  }

  /* Brand (footer uses the larger wordmark). Known duplication with Nav.astro. */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }
  .brand :global(.brand-mark) {
    display: block;
    width: 30px;
    height: 30px;
    flex: none;
  }
  .brand-name {
    font-family: var(--display);
    font-size: 20px; /* was 24px mixed case; caps + "CHURCH" must fit the 1.4fr column */
    font-weight: 600;
    letter-spacing: 0.02em; /* opened up for all caps, as in the Nav */
    text-transform: uppercase; /* NORTH WAKE CHURCH — Todd, 2026-09-26 */
    line-height: 1.15; /* if it ever wraps, the two lines stack as a tidy lockup */
    color: var(--ink);
  }
  .brand-name .accent {
    color: var(--accent);
  }
  /* Each half stays whole: a wrap is always NORTH WAKE / CHURCH, never 3 lines. */
  .brand-name .nw {
    white-space: nowrap;
  }

  .blurb {
    max-width: 32ch;
    color: var(--ink-3);
    margin: 0;
  }
  .footer-actions {
    margin-top: 28px;
    display: flex;
    gap: 8px;
  }
  .footer-actions .btn {
    padding: 10px 18px;
    font-size: 13px;
  }

  .footer h5 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 18px;
  }
  .footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer li {
    font-size: 14px;
    color: var(--ink-2);
    letter-spacing: -0.005em;
  }
  .footer li a {
    color: inherit;
    transition: color 140ms ease;
  }
  .footer li a:hover {
    color: var(--accent);
  }
  .footer li.static {
    color: var(--ink-3);
  }

  .contact {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact .label {
    margin-bottom: 4px;
  }
  .contact .value {
    color: var(--ink-2);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--ink-3);
  }

  /* ≤1180 (the Nav's hamburger switch): the brand block takes its own full row and
     the four link columns sit beneath, so the wordmark isn't squeezed into 1.4fr. */
  @media (max-width: 1180px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    /* Brand + blurb + actions span both columns so the wordmark isn't crushed
       into half the width (2026-09-26). */
    .footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
