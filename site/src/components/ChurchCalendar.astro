---
// Weekly church calendar (top of /events). Data = the church's Google Calendar feed,
// read at build time by src/lib/church-calendar.ts. ZERO JS:
// - Week paging: every week is pre-rendered; Previous/Next are #anchors and CSS :target
//   shows the targeted week (the first/current week shows when nothing is targeted).
// - Details: each entry is a <button popovertarget> that opens a native HTML popover
//   card (light-dismiss + Esc are built into the browser). No script, no library.
// Desktop = a 7-column week row with minimal entries (start time + title). ≤900px = a
// compact day-by-day list with the same tap-for-details cards.
import { getChurchCalendar } from "../lib/church-calendar";
import { CHURCH_CALENDAR } from "../data/calendar";

const cal = await getChurchCalendar();
---

<section class="cal-sec" aria-labelledby="cal-title">
  <div class="wrap">
    <div class="cal-head">
      <div>
        <div class="eyebrow cal-eyebrow"><span class="dot"></span>Church calendar</div>
        <h2 id="cal-title" class="display-s cal-title">What’s happening this week.</h2>
      </div>
      <a class="cal-google" href={CHURCH_CALENDAR.googleUrl} target="_blank" rel="noopener">
        Open in Google Calendar <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    {
      cal.ok ? (
        <div class="cal-weeks">
          {cal.weeks.map((w, wi) => {
            const prev = cal.weeks[wi - 1];
            const next = cal.weeks[wi + 1];
            return (
              <div class="cal-week" id={w.id} aria-label={`Week of ${w.label}`}>
                <div class="cal-nav">
                  {prev ? (
                    <a class="cal-nav-btn" href={`#${prev.id}`}>
                      <span aria-hidden="true">←</span> Previous<span class="cal-nav-long"> week</span>
                    </a>
                  ) : (
                    <span class="cal-nav-btn is-disabled" aria-hidden="true">
                      ← Previous<span class="cal-nav-long"> week</span>
                    </span>
                  )}
                  <div class="cal-range">
                    {wi === 0 && <span class="mono cal-range-tag">This week</span>}
                    <span class="cal-range-dates">{w.label}</span>
                  </div>
                  {next ? (
                    <a class="cal-nav-btn" href={`#${next.id}`}>
                      Next<span class="cal-nav-long"> week</span> <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="cal-nav-btn is-disabled" aria-hidden="true">
                      Next<span class="cal-nav-long"> week</span> →
                    </span>
                  )}
                </div>

                <ol class="cal-grid">
                  {w.days.map((d) => (
                    <li class={`cal-day${d.isToday ? " is-today" : ""}${d.events.length ? "" : " is-empty"}`}>
                      <div class="cal-day-head">
                        <span class="mono cal-dow" aria-hidden="true">{d.weekday.slice(0, 3)}</span>
                        <span class="cal-num" aria-hidden="true">{d.dayNum}</span>
                        {d.isToday && <span class="mono cal-today">Today</span>}
                        <span class="sr-only">{d.weekday}, {d.dateLabel}</span>
                      </div>
                      {d.events.length ? (
                        <ul class="cal-events">
                          {d.events.map((e, ei) => {
                            const pid = `cal-${d.key}-${ei}`;
                            return (
                              <li>
                                <button
                                  type="button"
                                  class={`cal-ev${e.allDay ? " is-allday" : ""}`}
                                  popovertarget={pid}
                                >
                                  <span class="mono cal-ev-time">{e.startLabel}</span>
                                  <span class="cal-ev-title">{e.title}</span>
                                </button>
                                <div class="cal-pop" id={pid} popover="auto" role="dialog" aria-labelledby={`${pid}-t`}>
                                  <button
                                    type="button"
                                    class="cal-pop-close"
                                    popovertarget={pid}
                                    popovertargetaction="hide"
                                    aria-label="Close"
                                  >
                                    ×
                                  </button>
                                  <div class="mono cal-pop-date">{d.weekday}, {d.dateLabel}</div>
                                  <h3 class="cal-pop-title" id={`${pid}-t`}>{e.title}</h3>
                                  <dl class="cal-pop-facts">
                                    <div>
                                      <dt class="mono">When</dt>
                                      <dd>{e.timeLabel}</dd>
                                    </div>
                                    {e.location && (
                                      <div>
                                        <dt class="mono">Where</dt>
                                        <dd>{e.location}</dd>
                                      </div>
                                    )}
                                  </dl>
                                  {e.description && <p class="cal-pop-desc">{e.description}</p>}
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      ) : (
                        <p class="cal-empty">
                          <span aria-hidden="true">—</span>
                          <span class="sr-only">Nothing scheduled</span>
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="cal-fallback">
          The church calendar is unavailable right now.{" "}
          <a href={CHURCH_CALENDAR.googleUrl} target="_blank" rel="noopener">View it on Google Calendar ↗</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cal-sec {
    padding-top: 24px;
  }
  .cal-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }
  .cal-eyebrow {
    margin-bottom: 14px;
  }
  .cal-title {
    margin: 0;
  }
  .cal-google {
    font-size: 16px;
    font-weight: 500;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }
  .cal-google:hover {
    color: var(--ink);
  }

  /* Week paging — CSS :target, zero JS. Only one week is visible: the targeted one, or
     the first (current) week when none is targeted. */
  .cal-week {
    display: none;
    scroll-margin-top: 96px; /* the week's nav row lands below the sticky nav */
  }
  .cal-week:target,
  .cal-weeks:not(:has(.cal-week:target)) .cal-week:first-child {
    display: block;
  }

  .cal-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 2px solid var(--ink);
  }
  .cal-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  a.cal-nav-btn:hover {
    border-color: var(--ink);
  }
  .cal-nav-btn.is-disabled {
    color: var(--ink-4);
    border-color: var(--line);
  }
  .cal-range {
    display: flex;
    align-items: baseline;
    gap: 12px;
    text-align: center;
  }
  .cal-range-tag {
    color: var(--accent);
  }
  .cal-range-dates {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* 7-column week row (hairline grid). */
  .cal-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cal-day {
    background: var(--bg-raised);
    padding: 14px 10px 16px;
    min-height: 170px;
  }
  .cal-day-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }
  .cal-dow {
    color: var(--ink-3);
  }
  .cal-num {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cal-today {
    margin-left: auto;
    color: var(--accent);
  }
  .cal-day.is-today {
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .cal-day.is-today .cal-num {
    color: var(--accent);
  }
  .cal-events {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .cal-empty {
    margin: 0;
    color: var(--ink-4);
  }

  /* An entry = a button that opens its popover card. */
  .cal-ev {
    display: block;
    width: 100%;
    text-align: left;
    padding: 8px 10px 9px;
    background: var(--bg-2);
    border: 0;
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    color: var(--ink);
    cursor: pointer;
    transition: background 120ms ease;
  }
  .cal-ev:hover {
    background: var(--bg-3);
  }
  .cal-ev:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cal-ev.is-allday {
    border-left-color: var(--ink);
  }
  .cal-ev-time {
    display: block;
    color: var(--ink-3);
    margin-bottom: 3px;
  }
  .cal-ev-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  /* Popover card (native top layer; the browser centres it). */
  .cal-pop {
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    overflow: auto;
    padding: 28px 28px 30px;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-dropdown);
  }
  .cal-pop::backdrop {
    background: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .cal-pop-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .cal-pop-close:hover {
    border-color: var(--ink);
  }
  .cal-pop-date {
    color: var(--accent);
    margin-bottom: 10px;
    padding-right: 48px;
  }
  .cal-pop-title {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 18px;
    padding-right: 36px;
  }
  .cal-pop-facts {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .cal-pop-facts > div {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .cal-pop-facts dt {
    color: var(--ink-3);
  }
  .cal-pop-facts dd {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
  }
  .cal-pop-desc {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    white-space: pre-line; /* keeps the feed's line breaks / bullets */
    overflow-wrap: anywhere;
  }

  .cal-fallback {
    padding: 24px 0;
    border-top: 2px solid var(--ink);
    font-size: 18px;
  }
  .cal-fallback a {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  /* ≤900: the week becomes a compact day-by-day list. */
  @media (max-width: 900px) {
    .cal-grid {
      display: block;
      background: none;
      border: 0;
    }
    .cal-day {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 14px;
      min-height: 0;
      padding: 14px 0;
      background: none; /* list view sits on the page, not raised cells */
      border-bottom: 1px solid var(--line);
    }
    .cal-day-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin: 0;
    }
    .cal-today {
      margin-left: 0;
    }
    .cal-day.is-today {
      box-shadow: inset 2px 0 0 var(--accent);
      padding-left: 10px;
    }
    .cal-ev-title {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
  @media (max-width: 560px) {
    .cal-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .cal-nav-long {
      display: none;
    }
    .cal-range {
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .cal-range-dates {
      font-size: 16px;
    }
  }
</style>
