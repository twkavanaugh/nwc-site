---
// "F · Warm Band" split hero — text left on a --bg-2 band, photo filling the full
// band height on the right. Source: brand/prototype/HERO-WARM-BAND.md +
// hero-warm-band.html. Zero JS. Consumers: /visit, /mission/church-planting,
// /mission/training, /mission/international, /about/membership,
// /community/grow-groups, /community/students.
//
// A CTA with no `href` renders as an inert <button type="button"> — the site's
// convention for an unwired placeholder action (see help/feed.astro).

interface Cta {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  headlineLead: string;
  headlineAccent: string; // keep to the last clause (kit §7)…
  headlineTail?: string; // …unless a page's kit accents mid-sentence: text AFTER the accent
  lede: string;
  // caption: optional on-photo identification line (e.g. who is pictured), shown at
  // the bottom over a scrim. focus: "left" keeps a left-of-centre subject in the crop.
  photo?: { src: string; alt: string; caption?: string; focus?: "left" };
  photoPlaceholder?: string; // no photo yet → labeled .ph block (e.g. help/feed hero)
  headlineSize?: "l" | "m"; // "m" for sentence-length headlines (~80 chars)
  headlineStep?: boolean; // opt-in: one step down from "l" (Community pages, 2026-10-11)
  primary?: Cta;
  ghost?: Cta;
  titleId?: string; // lets the page label the section via aria-labelledby
}

const {
  eyebrow,
  headlineLead,
  headlineAccent,
  headlineTail,
  lede,
  photo,
  photoPlaceholder = "Photo",
  headlineSize = "l",
  headlineStep = false,
  primary,
  ghost,
  titleId = "warm-band-title",
} = Astro.props;
const h1Class =
  headlineSize === "m"
    ? "display-m warm-band-h1 warm-band-h1--m"
    : `display-l${headlineStep ? " display-l--step" : ""} warm-band-h1`;
---

<section class="warm-band" aria-labelledby={titleId}>
  <div class="warm-band-grid">
    <div class="warm-band-text">
      <div class="eyebrow warm-band-eyebrow"><span class="dot"></span>{eyebrow}</div>
      <h1 id={titleId} class={h1Class}>
        {headlineLead} <span class="warm-band-accent">{headlineAccent}</span>{headlineTail}
      </h1>
      <p class="lede warm-band-lede">{lede}</p>
      {(primary || ghost) && (
      <div class="warm-band-actions">
        {
          primary && (primary.href ? (
            <a class="btn btn-primary" href={primary.href}>
              {primary.label} <span class="arr" aria-hidden="true">→</span>
            </a>
          ) : (
            <button type="button" class="btn btn-primary">
              {primary.label} <span class="arr" aria-hidden="true">→</span>
            </button>
          ))
        }
        {
          ghost &&
            (ghost.href ? (
              <a class="btn btn-ghost" href={ghost.href}>{ghost.label}</a>
            ) : (
              <button type="button" class="btn btn-ghost">{ghost.label}</button>
            ))
        }
      </div>
      )}
    </div>
    {
      photo ? (
        photo.caption ? (
          <figure class="warm-band-photo warm-band-figure">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="eager"
              decoding="async"
              class:list={[photo.focus && `warm-band-img--focus-${photo.focus}`]}
            />
            <figcaption class="warm-band-caption">{photo.caption}</figcaption>
          </figure>
        ) : (
          <div class="warm-band-photo">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="eager"
              decoding="async"
              class:list={[photo.focus && `warm-band-img--focus-${photo.focus}`]}
            />
          </div>
        )
      ) : (
        <div class="warm-band-photo ph warm-band-ph">
          <span class="ph-label">{photoPlaceholder}</span>
        </div>
      )
    }
  </div>
</section>

<style>
  /* padding:0 beats the global `section:first-of-type { padding-top: 56px }` —
     Astro's scoped class selector out-specifies it (0,2,0 vs 0,1,1). */
  .warm-band {
    padding: 0;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  /* align-items: stretch is what makes the photo fill the band's full height (kit §5). */
  .warm-band-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: stretch;
  }
  /* Gutter-aware left padding lines the text up with .wrap (1320px max, 40px
     gutter) while the band runs full width. Coupled to .wrap in global.css. */
  .warm-band-text {
    padding: 80px 64px 80px max(40px, calc((100vw - 1320px) / 2 + 40px));
  }
  .warm-band-eyebrow {
    margin-bottom: 36px;
  }
  .warm-band-h1 {
    max-width: 15ch;
  }
  .warm-band-h1--m {
    max-width: 16ch;
  }
  .warm-band-accent {
    color: var(--accent);
  }
  .warm-band-lede {
    margin-top: 32px;
  }
  .warm-band-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  /* --bg-3 shows if the image fails to load (kit §9). */
  .warm-band-photo {
    position: relative;
    min-height: 520px;
    background: var(--bg-3);
  }
  .warm-band-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Left-of-centre subject (e.g. /mission/church-planting speaker): bias the cover
     crop left and slightly up so the face survives the short stacked band. */
  .warm-band-img--focus-left {
    object-position: 30% 30%;
  }
  /* Captioned photo: <figure> needs its UA margin cleared. The caption sits on a
     bottom scrim (token color-mix of --bg-inverse) so --on-image-fg stays legible on
     any photo. 16px: it names who is pictured, so it isn't exempt micro-type. */
  .warm-band-figure {
    margin: 0;
  }
  .warm-band-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 56px 28px 20px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--on-image-fg);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-inverse) 82%, transparent) 0%,
      color-mix(in srgb, var(--bg-inverse) 55%, transparent) 55%,
      transparent 100%
    );
  }

  /* Flush-edge placeholder: square corners, like the real photo it stands in for. */
  .warm-band-ph {
    border-radius: 0;
  }

  @media (max-width: 880px) {
    .warm-band-grid {
      grid-template-columns: 1fr;
    }
    .warm-band-text {
      padding: 56px 40px;
    }
    .warm-band-photo {
      min-height: 320px;
      order: -1; /* photo on top when stacked */
    }
  }
  /* 22px matches the .wrap mobile gutter in global.css — change together. */
  @media (max-width: 720px) {
    .warm-band-text {
      padding: 44px 22px 56px;
    }
  }
</style>
